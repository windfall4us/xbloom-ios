<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>xBloom 咖啡豆仓</title>
<style>
:root{--bg:#f5f1ea;--panel:#fffdf9;--text:#28221e;--muted:#776e66;--line:#e6ddd2;--accent:#885b3d;--soft:#f1e6da;--ok:#476b53;--bad:#a34a3a;--warn:#9b6d35}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,system-ui,-apple-system,"Segoe UI","PingFang SC","Microsoft YaHei",sans-serif}
.wrap{max-width:1260px;margin:auto;padding:22px}.top{display:flex;justify-content:space-between;align-items:end;gap:12px;margin-bottom:16px}
h1,h2,h3{margin:0}.muted{color:var(--muted);font-size:13px}.actions{display:flex;gap:8px;flex-wrap:wrap}
button{font:inherit}.action{border:0;border-radius:10px;padding:10px 13px;background:var(--accent);color:white;font-weight:700;cursor:pointer}.secondary{background:#eee6dc;color:#5d5047;border:1px solid #ddd0c2}
.tabs{display:flex;gap:8px;margin:14px 0}.tab{border:1px solid var(--line);background:white;border-radius:999px;padding:8px 12px}.tab.active{background:var(--soft);border-color:#c3a187}
.search{width:100%;padding:11px;border:1px solid var(--line);border-radius:12px;background:white;font:inherit;margin-bottom:14px}
.warehouse{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.bean-card{background:var(--panel);border:1px solid var(--line);border-radius:17px;overflow:hidden;cursor:pointer;display:flex;flex-direction:column}
.bean-img{width:100%;aspect-ratio:4/3;object-fit:cover;background:#eee7de}.img-placeholder{aspect-ratio:4/3;display:flex;align-items:center;justify-content:center;background:#eee7de;color:#9a9087}.bean-body{padding:14px}
.bean-title{display:flex;justify-content:space-between;gap:10px}.bean-title b{font-size:18px}.tags{display:flex;gap:6px;flex-wrap:wrap;margin:10px 0}.tag{background:#f4ece3;border:1px solid #e6d8c9;border-radius:999px;padding:5px 8px;font-size:12px}
.intro{font-size:13px;color:#5f5750;line-height:1.55;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
.detail{display:grid;grid-template-columns:350px 1fr;gap:16px}.card{background:var(--panel);border:1px solid var(--line);border-radius:17px;padding:16px}.heroimg{width:100%;border-radius:13px;max-height:360px;object-fit:cover;background:#eee7de}
.info-section{margin-top:16px}.info-section h3{font-size:14px;margin-bottom:7px}.info-section p{margin:0;line-height:1.65;color:#514a44}
.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin:14px 0}.metric{background:#faf6f0;border:1px solid var(--line);border-radius:12px;padding:12px}.metric b{font-size:20px}
.status{display:inline-flex;align-items:center;padding:5px 8px;border-radius:999px;font-size:12px;font-weight:800}.ok{background:#e7f0e9;color:var(--ok)}.bad{background:#f5e7e4;color:var(--bad)}.warn{background:#f6eee0;color:var(--warn)}
.validation{margin-top:10px;padding:12px;border:1px solid var(--line);border-radius:13px;background:#faf6f0}.validation-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:9px}
.recipe-lines{margin-top:10px}.row{display:flex;justify-content:space-between;gap:10px;padding:7px 0;border-top:1px dashed var(--line)}.row:first-child{border-top:0}
.symptoms{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.sym{min-height:68px;border:1px solid var(--line);background:#fff;border-radius:12px;padding:9px;cursor:pointer;text-align:left}.sym.active{background:var(--soft);border-color:#bd997c}
.compare{display:grid;grid-template-columns:1fr 40px 1fr;gap:10px;margin-top:12px}.box{border:1px solid var(--line);border-radius:13px;padding:12px;background:#fff}.next{background:#fffaf5}.arrow{display:flex;align-items:center;justify-content:center;font-size:25px;color:#a1816a}
pre{white-space:pre-wrap;word-break:break-word;background:#241f1b;color:#f8eee6;border-radius:12px;padding:12px;max-height:420px;overflow:auto;font-size:12px}.hidden{display:none!important}
.back{margin-bottom:12px}.section-gap{margin-top:14px}.history-block{margin-top:12px}

.form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
.form-field{display:flex;flex-direction:column;gap:5px}
.form-field.full{grid-column:1/-1}
.form-field label,.section-label{font-size:12px;color:var(--muted);font-weight:700}
.form-field input,.form-field select,.form-field textarea{width:100%;padding:11px;border:1px solid var(--line);border-radius:10px;background:white;font:inherit;color:var(--text)}
.capture-panel{border:1px dashed #c8aa91;border-radius:14px;padding:12px;background:#fffaf5}
.capture-row{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.capture-preview{display:none;margin-top:10px;width:100%;max-height:220px;object-fit:contain;border-radius:12px;background:#eee7de}
.recognition-result{margin-top:10px;padding:10px;border-radius:10px;background:#f5efe7;font-size:12px;line-height:1.55}
.mobile-dialog-card{max-height:min(88vh,860px);overflow:auto}
.dialog-head{position:sticky;top:0;background:var(--panel);z-index:3;padding-bottom:10px;border-bottom:1px solid var(--line);margin-bottom:12px}
.dialog-footer{position:sticky;bottom:0;background:var(--panel);padding-top:10px;border-top:1px solid var(--line);margin-top:12px}



.sync-slot-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-top:14px}
.sync-slot-card{border:1px solid var(--line);border-radius:14px;padding:14px;background:#fffaf5}
.sync-slot-title{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:10px}
.sync-select{margin:0;width:100%;padding:11px 12px}
.sync-info{margin-top:9px;line-height:1.55;min-height:38px}
.sync-result-row{display:grid;grid-template-columns:64px 1fr auto;gap:10px;padding:11px 0;border-bottom:1px dashed var(--line);align-items:center}
@media(max-width:720px){
 .sync-slot-grid{grid-template-columns:1fr}
 .sync-result-row{grid-template-columns:48px 1fr}
 .sync-result-row .status{grid-column:2}
}


.detail-top-tabs{display:flex;gap:10px;position:sticky;top:10px;z-index:3;margin-bottom:14px}
.tab{padding:12px 16px;border:1px solid var(--line);border-radius:12px;background:#fff7ef;font-weight:700;cursor:pointer}
.tab.active{background:var(--accent);color:#fff;border-color:var(--accent)}
.detail-pane{display:block}
.bean-info-table{display:grid;gap:0}
.bean-info-table .row{display:flex;justify-content:space-between;gap:12px;padding:12px 0;border-bottom:1px solid var(--line)}
.bean-info-table .row:last-child{border-bottom:none}
.bean-info-table .row span{color:var(--muted)}
@media(max-width:720px){.detail-top-tabs{top:6px;overflow:auto;white-space:nowrap}}

.detail-section-head{display:flex;align-items:flex-start;justify-content:space-between;gap:14px;flex-wrap:wrap}
.extract-metric-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0;margin-top:14px;background:#f1efed;border-radius:18px;padding:10px 6px}
.extract-metric-card{border:0;border-right:1px solid #d8d5d2;background:transparent;border-radius:0;padding:13px 8px;text-align:center;min-width:0}.extract-metric-card:nth-child(3n){border-right:0}
.extract-metric-card span{display:block;color:#5e5148;font-size:13px;margin-bottom:4px;letter-spacing:.02em}
.extract-metric-card b{font-size:25px;line-height:1.12;font-weight:700;color:#111}
.pour-card-grid{display:flex;flex-wrap:nowrap;gap:0;margin-top:14px;overflow-x:auto;overflow-y:hidden;-webkit-overflow-scrolling:touch;scroll-snap-type:x proximity;padding-bottom:6px;max-width:100%}
.pour-step-card{flex:0 0 148px;border:0;border-right:1px solid #dedbd8;border-radius:0;padding:10px 11px;background:transparent;min-width:148px;scroll-snap-align:start;text-align:left}.pour-step-card:last-child{border-right:0}
.pour-step-title{display:flex;justify-content:space-between;gap:6px;align-items:center;margin-bottom:8px;font-size:14px}
.pour-step-water{font-size:31px;font-weight:700;line-height:1.05;color:#111;margin:4px 0 10px}
.pour-visual{height:118px;border-radius:16px;background:#ebe9ef;margin:10px 0 12px}
.pour-detail{display:grid;gap:4px;font-size:13px;line-height:1.35}
.pour-detail span{color:#6d5e54}
.operation-groups{display:grid;gap:16px}
.operation-group{padding-bottom:14px;border-bottom:1px solid var(--line)}
.operation-group:last-child{border-bottom:none;padding-bottom:0}
.adjust-advice-card{border:1px solid var(--line);border-radius:15px;padding:14px;background:#fffaf5;line-height:1.65}
.adjust-advice-list{display:grid;gap:6px;margin-top:8px}
.adjust-advice-list div:before{content:'• ';color:var(--accent);font-weight:800}
@media(max-width:720px){.extract-metric-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.pour-card-grid{grid-template-columns:1fr 1fr}}
@media(max-width:430px){.pour-card-grid{grid-template-columns:1fr}}

/* v2.2.7: detail tabs always occupy the full content width, including browser zoom. */
.detail.detail-tabbed{display:block!important;width:100%;min-width:0;grid-template-columns:none!important}
.detail-top-tabs{display:grid!important;grid-template-columns:repeat(3,minmax(0,1fr));width:100%;min-width:0;box-sizing:border-box;position:sticky;top:10px;z-index:5;margin-bottom:14px}
.detail-top-tabs .tab{width:100%;min-width:0;text-align:center;white-space:nowrap}
.detail-pane{width:100%;min-width:0}
.detail-pane>main,.detail-pane>aside{width:100%;min-width:0;box-sizing:border-box}

/* Every pour stays on one row. Columns expand equally to fill the row; narrow screens scroll only inside this section. */
.pour-card-grid{display:grid!important;grid-auto-flow:row;gap:0;width:100%;max-width:100%;overflow-x:auto;overflow-y:hidden;scroll-snap-type:x proximity;-webkit-overflow-scrolling:touch;padding-bottom:6px}
.pour-step-card{min-width:0!important;width:auto!important;max-width:none!important;box-sizing:border-box;scroll-snap-align:start}

.promotion-panel{border:1px solid var(--line);border-radius:15px;padding:14px;background:#fffaf5}
.promotion-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;flex-wrap:wrap}
.promotion-change-list{display:grid;gap:7px;margin-top:10px}
.promotion-change{display:grid;grid-template-columns:minmax(110px,1fr) 1fr auto 1fr;gap:8px;align-items:center;border-top:1px dashed var(--line);padding-top:7px}
.promotion-change .before{color:var(--muted);text-align:right}.promotion-change .after{font-weight:800}.promotion-change .arrow{font-size:15px;transform:none}
.version-timeline{display:grid;gap:0;margin-top:12px}
.timeline-item{position:relative;padding:0 0 18px 28px;min-height:48px}
.timeline-item:before{content:'';position:absolute;left:7px;top:8px;width:10px;height:10px;border-radius:50%;background:var(--accent);z-index:2}
.timeline-item:after{content:'';position:absolute;left:11px;top:18px;bottom:-2px;width:2px;background:var(--line)}
.timeline-item:last-child:after{display:none}
.timeline-time{font-size:12px;color:var(--muted);margin-top:3px}
.timeline-detail{font-size:13px;color:var(--muted);margin-top:4px;line-height:1.5}
.candidate-row{display:grid;grid-template-columns:1fr auto;gap:10px;align-items:center;padding:10px 0;border-top:1px dashed var(--line)}
.candidate-row:first-child{border-top:0}
@media(max-width:720px){
 .detail-top-tabs{top:6px}
 .promotion-change{grid-template-columns:1fr 1fr;gap:5px}
 .promotion-change .label{grid-column:1/-1}.promotion-change .before{text-align:left}.promotion-change .arrow{display:none}
}

.action.danger{background:#8f3d32;color:#fff;border-color:#8f3d32}
.duplicate-pairs{display:grid;gap:14px;margin-top:14px;max-height:65vh;overflow:auto}
.duplicate-pair{border:1px solid var(--line);border-radius:16px;padding:14px;background:#fffaf5}
.duplicate-score{font-size:24px;font-weight:800}
.duplicate-columns{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:10px}
.duplicate-bean{border:1px solid var(--line);border-radius:12px;padding:12px;background:#fff}
.duplicate-bean h4{margin:0 0 6px}
.duplicate-reasons{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}
.duplicate-reason{font-size:12px;padding:4px 7px;border-radius:999px;background:#f0e8df}
@media(max-width:720px){.duplicate-columns{grid-template-columns:1fr}.duplicate-governance-card{padding:14px}}
.bottom-nav{position:fixed;left:0;right:0;bottom:0;z-index:30;background:rgba(250,246,241,.96);backdrop-filter:blur(8px);border-top:1px solid var(--line);display:flex;justify-content:space-around;gap:8px;padding:10px max(12px,env(safe-area-inset-right)) calc(10px + env(safe-area-inset-bottom)) max(12px,env(safe-area-inset-left))}
.bottom-nav button{flex:1;border:1px solid var(--line);background:white;border-radius:12px;padding:12px 10px;font:inherit;font-weight:800;color:var(--text)}
.bottom-nav button.active{background:#e8d7c8}
body{padding-bottom:92px}
.settings-row{display:grid;grid-template-columns:1fr;gap:10px}
#settingsView .tabs{display:flex;gap:8px}
#settingsView .tab{cursor:pointer}
#settingsView .tab.active{background:var(--soft);border-color:#c3a187;font-weight:800}
.intake-steps{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin-top:10px}
.intake-step{font-size:11px;text-align:center;padding:7px 5px;border-radius:9px;background:#f2ece5;color:var(--muted);border:1px solid var(--line)}
.intake-step.active{background:#ead9ca;color:var(--text);font-weight:800;border-color:#c7a88f}
.intake-step.done{background:#e7f0e9;color:var(--ok);border-color:#b8d0be}
.intake-summary{margin-top:10px;padding:10px;border-radius:10px;background:#fff8ef;border:1px solid var(--line);font-size:12px;line-height:1.6}

.switch-row{display:flex;align-items:center;justify-content:space-between;padding:10px 12px;border:1px solid var(--line);border-radius:10px;background:#fffaf5}
.switch-row input{width:18px;height:18px}

@media(max-width:980px){.warehouse{grid-template-columns:repeat(2,1fr)}.detail{grid-template-columns:1fr}.metrics,.validation-grid{grid-template-columns:repeat(2,1fr)}.symptoms{grid-template-columns:repeat(2,1fr)}.compare{grid-template-columns:1fr}.arrow{transform:rotate(90deg)}}
@media(max-width:580px){
.warehouse{grid-template-columns:1fr}.symptoms{grid-template-columns:1fr}.top{align-items:flex-start;flex-direction:column}
.form-grid{grid-template-columns:1fr}
#newBeanView{width:100vw!important;max-width:none!important;height:100dvh;max-height:none;margin:0;border-radius:0!important}
#newBeanView .mobile-dialog-card{height:100dvh;max-height:none;border-radius:0;padding:14px}
#newBeanView::backdrop{background:rgba(0,0,0,.45)}
#newBeanView .dialog-head{padding-top:4px}
#newBeanView .dialog-footer .actions{display:grid;grid-template-columns:1fr}
#newBeanView .dialog-footer button{width:100%;min-height:46px}
.capture-row{display:grid;grid-template-columns:1fr}
.capture-row .action{width:100%;min-height:46px}
}

.tasting-multi{position:relative;margin-top:8px}.multi-toggle{width:100%;display:flex;justify-content:space-between;align-items:center;padding:10px 12px;border:1px solid var(--line);border-radius:10px;background:#fff;cursor:pointer}.multi-menu{position:absolute;z-index:30;left:0;right:0;top:46px;background:#fff;border:1px solid var(--line);border-radius:12px;box-shadow:0 12px 28px rgba(0,0,0,.12);padding:8px}.multi-menu label{display:flex;gap:8px;align-items:center;padding:8px;border-radius:8px;cursor:pointer}.multi-menu label:hover{background:var(--soft)}.multi-tags{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}.multi-tag{display:inline-flex;gap:6px;align-items:center;padding:5px 8px;border-radius:999px;background:var(--soft);font-size:12px}.latest-tasting-card{border:1px solid var(--line);border-radius:12px;padding:12px;background:#fff}.latest-tasting-tags{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}.latest-tasting-tag{padding:5px 8px;border-radius:999px;background:var(--soft);font-size:12px}.workflow-actions{display:flex;gap:8px;flex-wrap:wrap}.workflow-note{font-size:12px;color:var(--muted);margin-top:8px}
.warehouse-tools{gap:8px;align-items:center}.warehouse-tools .filterBtn.active{background:var(--ink);color:#fff;border-color:var(--ink)}.lifecycle-badge{display:inline-flex;align-items:center;padding:3px 7px;border-radius:999px;font-size:11px;margin-left:6px;background:var(--soft)}.lifecycle-badge.resting{background:#fff3d9}.lifecycle-badge.archived{background:#eee}.tasting-history-list{display:grid;gap:10px}.tasting-history-item{border:1px solid var(--line);border-radius:12px;padding:12px;background:#fff}.tasting-history-head{display:flex;justify-content:space-between;gap:12px;align-items:flex-start}.tasting-compare-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.tasting-compare-box{border:1px solid var(--line);border-radius:12px;padding:12px;background:#fff}.history-selects{display:grid;grid-template-columns:1fr 1fr;gap:10px}.history-selects select{width:100%}@media(max-width:640px){.tasting-compare-grid,.history-selects{grid-template-columns:1fr}}

/* v2.3.4 page-level add/settings + warehouse/recipe display polish */
.app-page{display:block;margin-bottom:84px}.app-page.hidden{display:none!important}.app-page>.card{max-width:980px;margin:0 auto}.app-page .mobile-dialog-card{max-height:none!important;height:auto!important;overflow:visible!important;border-radius:18px!important;padding:18px!important}.app-page .dialog-head{position:static!important}.app-page .dialog-footer{position:static!important}
#newBeanView{width:auto!important;max-width:none!important;height:auto!important;max-height:none!important;margin:0!important;border-radius:0!important}
#newBeanView::backdrop{display:none!important}
#settingsView .tabs{display:flex;gap:8px;flex-wrap:wrap}#settingsView .tab{cursor:pointer}#settingsView .tab.active{background:var(--soft);border-color:#c3a187;font-weight:800}
.warehouse-tools .filterBtn.active{background:var(--accent)!important;color:#fff!important;border-color:var(--accent)!important}
@media(max-width:640px){.app-page>.card{border-radius:0}.app-page .dialog-footer .actions{display:grid;grid-template-columns:1fr}.app-page .dialog-footer button{width:100%}}


/* v2.3.6 adjustment simplification + dripper session UX */
.adjust-hero{display:grid;gap:12px}.adjust-context{display:flex;gap:10px;flex-wrap:wrap;align-items:center}.compact-summary{border:1px solid var(--line);border-radius:14px;background:#fff;padding:14px}.compact-summary-head{display:flex;justify-content:space-between;gap:12px;align-items:center}.compact-summary-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:12px}.history-picker{display:grid;grid-template-columns:1fr auto 1fr;gap:10px;align-items:center}.history-pick-card{border:1px solid var(--line);border-radius:14px;background:#fff;padding:12px;text-align:left;cursor:pointer}.history-pick-card.active{border-color:var(--accent);box-shadow:0 0 0 1px var(--accent) inset}.history-record-menu{display:grid;gap:8px;margin-top:10px}.history-record-option{border:1px solid var(--line);border-radius:12px;padding:10px;background:#fff;cursor:pointer;text-align:left}.session-dripper{display:flex;align-items:center;gap:10px;flex-wrap:wrap}.session-dripper select{min-width:210px;padding:9px 10px;border:1px solid var(--line);border-radius:10px;background:#fff}.compact-details>summary{cursor:pointer;font-weight:800;list-style:none}.compact-details>summary::-webkit-details-marker{display:none}.compact-details>summary::after{content:"展开";float:right;color:var(--accent);font-size:12px}.compact-details[open]>summary::after{content:"收起"}.latest-candidate-card{border:1px solid var(--line);border-radius:14px;background:#fff;padding:14px}.compact-timeline .timeline-item:nth-child(n+4){display:none}.compact-timeline.expanded .timeline-item{display:block}@media(max-width:640px){.history-picker{grid-template-columns:1fr}.history-picker .arrow{transform:rotate(90deg)}.compact-summary-grid{grid-template-columns:1fr}}

/* v2.3.5 dripper-aware recipe engine + low-visual-priority recipe tools */
.dripper-registry-list{display:grid;gap:10px;margin-top:12px}.dripper-registry-item{border:1px solid var(--line);border-radius:12px;padding:12px;background:#fff}.dripper-registry-head{display:flex;justify-content:space-between;gap:10px;align-items:flex-start}.dripper-registry-meta{font-size:12px;color:var(--muted);margin-top:4px}.dripper-advanced{margin-top:10px;padding-top:10px;border-top:1px dashed var(--line)}
.recipe-tool-details{border:1px solid var(--line);border-radius:14px;background:#fff}.recipe-tool-details>summary{list-style:none;cursor:pointer;padding:14px 16px;font-weight:800;display:flex;align-items:center;justify-content:space-between}.recipe-tool-details>summary::-webkit-details-marker{display:none}.recipe-tool-details>summary::after{content:"▾";color:var(--muted)}.recipe-tool-details[open]>summary::after{content:"▴"}.recipe-tool-body{padding:0 16px 16px}.more-tool-details{margin-top:10px;border-top:1px solid var(--line);padding-top:10px}.more-tool-details>summary{cursor:pointer;color:var(--muted);font-weight:700}.dripper-note{font-size:12px;color:var(--muted);margin-top:5px}

/* v2.3.7 product UX polish */
.settings-back,.page-back{margin-bottom:12px}
#settingsView .tabs{display:flex!important;flex-wrap:nowrap!important;overflow-x:auto;white-space:nowrap;gap:8px;padding-bottom:4px;scrollbar-width:thin}
#settingsView .tab{flex:0 0 auto}
.resting-summary{display:flex;justify-content:space-between;gap:12px;align-items:center;padding:12px 14px;border:1px solid var(--line);border-radius:14px;background:#fffaf5}
.resting-rules-grid{display:grid;gap:8px;margin-top:12px}.resting-rule-row{display:grid;grid-template-columns:1fr 92px 28px;align-items:center;gap:8px;padding:8px 0;border-bottom:1px dashed var(--line)}
.resting-rule-row input{width:92px;padding:9px 10px;border:1px solid var(--line);border-radius:10px;background:#fff;font:inherit}.resting-rule-row input:disabled{background:#f1eee9;color:#8b8179}.resting-preview{margin-top:12px;padding:12px;border-radius:12px;background:#f5efe7;line-height:1.55}
.sync-header-card{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:14px}.sync-cloud-state{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.sync-dot{width:9px;height:9px;border-radius:50%;background:var(--warn)}.sync-dot.ok{background:var(--ok)}
.sync-slot-grid.compact{grid-template-columns:1fr;gap:10px}.sync-slot-grid.compact .sync-slot-card{padding:12px}.sync-slot-grid.compact .sync-info{min-height:0;margin-top:7px}.sync-common-note{margin-top:12px;padding:11px 12px;border-radius:12px;background:#f5efe7;line-height:1.55}.sync-actions-row{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}.sync-refresh-link{border:0;background:transparent;color:var(--accent);font-weight:700;cursor:pointer;padding:8px}
.intake-stage{margin-top:14px}.intake-stage.hidden{display:none!important}.intake-group{border:1px solid var(--line);border-radius:15px;padding:14px;background:#fffaf5;margin-top:12px}.intake-group h4{margin:0 0 10px}.intake-more summary{font-weight:800;cursor:pointer;padding:6px 0}.intake-primary-actions{display:grid;gap:9px;margin-top:16px}.intake-primary-actions .action{width:100%;min-height:48px}.intake-primary-actions .secondary{order:2}.resting-live-hint{margin-top:8px;color:var(--muted);font-size:12px}
.dripper-preset-badge{display:inline-flex;padding:3px 7px;border-radius:999px;background:#efe2d5;color:#805435;font-size:11px;font-weight:800;margin-left:6px}
@media(max-width:720px){.sync-header-card{align-items:flex-start;flex-direction:column}.resting-rule-row{grid-template-columns:1fr 82px 24px}.form-grid.intake-core{grid-template-columns:1fr}.intake-steps{overflow-x:auto;flex-wrap:nowrap}.intake-step{min-width:118px}}
</style>

<!-- XB_IOS_P0_BEGIN: iOS Capacitor-specific safe area & no-clipping; leave Web styling intact -->
<script>
(function () {
  var cap = window.Capacitor;
  var ios = /iPhone|iPad|iPod/.test(navigator.userAgent);
  var native = !!(cap && (typeof cap.isNativePlatform === 'function' ? cap.isNativePlatform() : true));
  if (ios && (native || location.protocol === 'capacitor:')) {
    document.documentElement.classList.add('xb-ios-p0');
  }
})();
</script>
<style>
/* Capacitor/iOS only: never change browser Web UI. */
html.xb-ios-p0 { width:100%; max-width:100%; overflow-x:clip; }
html.xb-ios-p0 body {
  width:100%; max-width:100%; min-width:0; overflow-x:clip;
  /* Existing WKWebView overlays iOS status bar: explicitly reserve top inset.
     min fallback is needed on WebViews reporting env(safe-area-inset-top)=0. */
  padding-top:max(54px, env(safe-area-inset-top, 0px));
  padding-bottom:0;
}
html.xb-ios-p0 .wrap {
  box-sizing:border-box; width:100%; min-width:0; max-width:100%;
  padding-left:max(12px, env(safe-area-inset-left, 0px));
  padding-right:max(12px, env(safe-area-inset-right, 0px));
  /* Reserve space for fixed nav including home indicator. */
  padding-bottom:calc(88px + env(safe-area-inset-bottom, 0px));
}
html.xb-ios-p0 .bottom-nav {
  box-sizing:border-box; width:100%; max-width:100%;
  padding-left:max(12px, env(safe-area-inset-left, 0px));
  padding-right:max(12px, env(safe-area-inset-right, 0px));
  padding-bottom:calc(10px + env(safe-area-inset-bottom, 0px));
}
html.xb-ios-p0 .bottom-nav button {min-width:0; padding-left:5px; padding-right:5px;}
/* Replace 4 * min-width:118px with four responsive steps. No DOM removal. */
html.xb-ios-p0 .intake-steps {
  display:grid; grid-template-columns:repeat(4,minmax(0,1fr));
  overflow-x:visible; width:100%; min-width:0; max-width:100%; gap:5px;
}
html.xb-ios-p0 .intake-step {
  min-width:0!important; width:100%; max-width:100%;
  white-space:normal; overflow-wrap:anywhere; word-break:normal;
  padding:8px 2px; font-size:clamp(9px,2.5vw,11px); line-height:1.25;
  touch-action:manipulation;
}
html.xb-ios-p0 .card,
html.xb-ios-p0 .detail,
html.xb-ios-p0 .detail-pane,
html.xb-ios-p0 .form-grid,
html.xb-ios-p0 .sync-slot-grid,
html.xb-ios-p0 .capture-panel {min-width:0; max-width:100%;}
html.xb-ios-p0 img {max-width:100%;}
/* Keep existing intentional horizontal scroll: tabs and pour cards. */
html.xb-ios-p0 .settings-tabs,
html.xb-ios-p0 .pour-card-grid {max-width:100%;}
@media (max-width:375px){html.xb-ios-p0 .intake-step{font-size:9px;padding:7px 1px;}}
</style>
<!-- XB_IOS_P0_END -->
</head>
<body>
<div class="wrap">
<div class="top">
 <div><h1>xBloom 咖啡豆仓</h1></div>
</div>

<section id="warehouseView">
 <div class="tabs"><span class="tab active">豆仓</span><span class="muted" style="align-self:center" id="stats"></span></div>
 <input class="search" id="search" placeholder="搜索豆名、烘焙商、风味、处理法…">
    <div class="actions warehouse-tools" style="margin-bottom:14px">
      <button class="action secondary filterBtn active" data-filter="drinking">在喝</button>
      <button class="action secondary filterBtn" data-filter="resting">养豆</button>
      <button class="action secondary filterBtn" data-filter="archived">归档</button>
      <button class="action secondary filterBtn" data-filter="all">全部</button>
      <button class="action" id="duplicateGovernanceBtn">重复整理</button>
    </div>
 <div class="warehouse" id="warehouse"></div>
</section>


<section id="syncView" class="hidden">
 <div class="card sync-header-card">
   <div><h3>xBloom 同步中心</h3><div class="sync-cloud-state section-gap"><span id="syncCloudDot" class="sync-dot"></span><b id="syncCloudStateLabel">读取中</b><span class="muted" id="syncCloudAccount">—</span></div></div>
   <div class="muted">Cloud Sync + 网站槽位记录</div>
 </div>
 <div class="card">
   <div class="detail-section-head"><div><h3>A / B / C 配方</h3><div class="muted">为三个网站槽位选择当前原生配方。</div></div></div>
   <div class="sync-slot-grid compact">
     <div class="sync-slot-card"><div class="sync-slot-title"><b>槽位 A</b><span id="syncStateA" class="status warn">未分配</span></div><select id="syncSelectA" class="search sync-select"></select><div id="syncInfoA" class="muted sync-info"></div></div>
     <div class="sync-slot-card"><div class="sync-slot-title"><b>槽位 B</b><span id="syncStateB" class="status warn">未分配</span></div><select id="syncSelectB" class="search sync-select"></select><div id="syncInfoB" class="muted sync-info"></div></div>
     <div class="sync-slot-card"><div class="sync-slot-title"><b>槽位 C</b><span id="syncStateC" class="status warn">未分配</span></div><select id="syncSelectC" class="search sync-select"></select><div id="syncInfoC" class="muted sync-info"></div></div>
   </div>
   <div class="sync-common-note">网站负责把 Current 同步到 xBloom Cloud，并记录 A / B / C；真正写入机器仍需在 xBloom App 中确认槽位并通过 BLE 写入。</div>
   <div class="sync-actions-row section-gap"><button class="action" id="syncApplyBtn">同步所选配方</button><div><span class="muted" id="syncLastRefresh">尚未刷新</span><button class="sync-refresh-link" id="syncRefreshBtn">↻ 刷新</button></div></div>
 </div>
 <div class="card hidden section-gap" id="syncResultBox"><h3>同步结果</h3><div id="syncResultRows"></div></div>
</section>


<section id="detailView" class="hidden">
 <button class="action secondary back" id="backBtn">← 返回豆仓</button>
 <div class="detail detail-tabbed">
  <div class="detail-top-tabs card">
   <button class="tab active" id="detailInfoTab">咖啡豆信息</button>
   <button class="tab" id="detailExtractionTab">萃取</button>
   <button class="tab" id="detailAdjustTab">调整</button>
  </div>

  <section id="detailInfoPane" class="detail-pane">
   <aside class="card">
    <div id="imageArea"></div>
    <div style="margin-top:14px"><h2 id="beanName"></h2><div class="muted" id="beanMeta"></div><div class="tags" id="flavors"></div></div>
    <div class="info-section"><h3>咖啡豆介绍</h3><p id="intro"></p></div>
    <div class="info-section"><h3>风味描述</h3><p id="flavorDesc"></p></div>
    <div class="info-section"><h3>冲煮方向</h3><p id="brewGuide"></p></div>
    <div class="info-section">
      <h3>咖啡豆信息</h3>
      <div class="bean-info-table">
        <div class="row"><span>烘焙度</span><b id="beanRoast">—</b></div>
        <div class="row"><span>滤杯</span><b id="beanDripper">xBloom Omni Dripper 2</b></div>
        <div class="row"><span>类型</span><b id="beanType">—</b></div>
        <div class="row"><span>产地</span><b id="beanOrigin">—</b></div>
        <div class="row"><span>品种</span><b id="beanVariety">—</b></div>
        <div class="row"><span>处理</span><b id="beanProcess">—</b></div>
        <div class="row"><span>烘焙商</span><b id="beanRoaster">—</b></div>
      </div>
    </div>
    <div class="actions section-gap">
      <button class="action" id="editBeanBtn">编辑咖啡豆信息</button>
      <button class="action secondary" id="favoriteBtn">收藏</button>
      <button class="action secondary" id="archiveBtn">归档</button>
      <button class="action danger" id="deleteBeanBtn">删除咖啡豆</button>
    </div>
   </aside>
  </section>

  
<section id="detailExtractionPane" class="detail-pane hidden">
 <main>
  <section class="card">
   <div class="detail-section-head">
     <div><h3>萃取参数</h3><div class="muted" id="extractionSourceHint">当前版本的核心冲煮参数</div><div class="session-dripper section-gap"><b>本次滤杯</b><select id="extractionDripperSelect"></select><button class="action secondary" id="adaptDripperBtn">生成滤杯适配候选</button></div></div>
     <div id="readyBadge"></div>
   </div>
   <div id="extractionRecipeState" class="validation section-gap hidden"></div>
   <div class="extract-metric-grid" id="extractMetricCards"></div>
  </section>

  <section class="card section-gap">
    <h3>注水</h3>
    <div class="muted">按照当前配方逐段展示注水量、温度、时长、水流与方式</div>
    <div class="pour-card-grid" id="pourCards"></div>
    <div class="recipe-lines hidden" id="currentRows"></div>
    <div class="metrics hidden" id="metrics"></div>
  </section>

  <section class="card section-gap">
    <h3>配方校验</h3>
    <div class="validation" id="validationBox"></div>
  </section>

  <section class="card section-gap cloud-state-card" id="cloudWorkflowBox">
    <div class="detail-section-head">
      <div><h3>xBloom 云端</h3><div class="muted">按当前版本判断同步状态</div></div>
      <span id="cloudSyncBadge" class="status warn">待同步</span>
    </div>
    <div class="bean-info-table">
      <div class="row"><span>云端配方</span><b id="cloudRecipeName">—</b></div>
      <div class="row"><span>最近同步</span><b id="cloudLastSync">—</b></div>
      <div class="row"><span>应用槽位</span><b id="cloudAppSlot">未分配</b></div>
    </div>
    <div class="muted section-gap">应用槽位只作为网站记录。实际 A / B / C 分配仍需在 xBloom 应用中完成，再由应用通过蓝牙写入机器。</div>
  </section>

  <section class="card section-gap">
    <div class="operation-group"><b>校验</b><div class="actions section-gap"><button class="action secondary" id="validateBtn">重新校验</button></div></div>
    <div class="operation-group section-gap"><b>云端</b><div class="actions section-gap"><button class="action" id="cloudSyncBtn">同步到 xBloom 云端</button><button class="action secondary" id="cloudListBtn">查看云端配方</button></div></div>
  </section>

  <details class="recipe-tool-details section-gap" id="recipeToolsDetails">
    <summary>配方工具</summary>
    <div class="recipe-tool-body">
      <div class="actions"><button class="action" id="generateExtractionBtn">生成首版萃取配方</button><button class="action secondary" id="showYamlBtn">查看配方</button><button class="action secondary" id="downloadYamlBtn">下载配方</button></div>
      <details class="more-tool-details">
        <summary>更多工具</summary>
        <div class="actions section-gap"><button class="action secondary" id="rawUrlBtn">显示原始链接</button><button class="action secondary" id="qrBtn">二维码</button><button class="action secondary" id="bundleBtn">导出豆仓包</button></div>
      </details>
    </div>
  </details>

  <div id="yamlArea" class="hidden section-gap"><pre id="yamlPre"></pre></div>
  <div id="rawArea" class="hidden section-gap"><div class="validation"><b>原始链接</b><div class="muted" id="rawUrlText" style="margin-top:6px;word-break:break-all"></div></div></div>
  <div id="qrArea" class="hidden section-gap"><div class="validation"><b>配方二维码</b><div style="margin-top:10px"><img id="qrImg" alt="配方二维码" style="max-width:260px;width:100%;border-radius:10px;background:white;padding:8px"></div></div></div>
 </main>
</section>


  <section id="detailAdjustPane" class="detail-pane hidden">
   <main>
    <section class="card">
      <div class="detail-section-head"><div><h3>本轮调整</h3><div class="muted">优先显示当前版本、最近反馈和最新候选；历史内容默认收起。</div></div><button class="action secondary" id="generateInitialBtn">生成首版候选</button></div>
      <div class="adjust-context section-gap"><span class="status ok" id="adjustCurrentVersion">当前版本 —</span><span class="status" id="adjustCurrentDripper">滤杯 —</span></div>
      <div id="latestTastingBox" class="latest-tasting-card section-gap"><div class="muted">还没有冲煮反馈。</div></div>
      <div class="workflow-actions section-gap"><button class="action" id="recordTastingTopBtn">记录冲煮反馈</button></div>
      <div class="symptoms hidden" id="symptoms"></div>
      <div class="adjust-advice-card section-gap" id="adjustAdviceBox"><b>系统建议</b><div class="muted" style="margin-top:8px">记录冲煮反馈后，这里会自动显示综合建议。</div></div>
    </section>

    <section class="card section-gap">
      <div class="detail-section-head"><div><h3>最新候选</h3><div class="muted">只展示最近一次候选的变化；旧候选收进版本管理。</div></div></div>
      <div class="compare" style="display:block">
        <div class="box next"><b id="nextTitle">等待冲煮反馈</b><div id="nextRows"></div></div>
      </div>
      <div class="validation section-gap" id="reason">保存反馈并生成调整方案后，这里显示候选变化。</div>
      <div class="actions section-gap"><button class="action hidden" id="saveCandidateBtn">保存候选</button><button class="action secondary" id="tastingBtn">记录冲煮反馈</button></div>
      <div id="compareCurrent" class="hidden"></div>
    </section>

    <section class="card section-gap">
      <details class="compact-details" id="versionManagementDetails"><summary>版本管理</summary>
        <div class="actions section-gap"><button class="action secondary" id="historyBtn">刷新版本</button><button class="action secondary" id="importBtn">导入配方</button></div>
        <div class="history-block" id="history"></div>
        <div class="section-gap promotion-panel" id="promotionSummary"><div id="promotionCandidateList"><div class="muted">暂无候选版本。</div></div></div>
      </details>
    </section>

    <section class="card section-gap">
      <details class="compact-details" id="tastingHistoryDetails"><summary>冲煮历史对比 <span class="muted" id="tastingHistoryCount"></span></summary>
        <div class="detail-section-head section-gap"><div class="muted">选择两次记录比较症状、滤杯和调整变化。</div><button class="action secondary" id="refreshTastingHistoryBtn">刷新</button></div>
        <div class="history-picker section-gap"><button class="history-pick-card" id="tastingCompareACard">选择较早记录</button><div class="arrow">↕</div><button class="history-pick-card" id="tastingCompareBCard">选择较新记录</button></div>
        <div id="tastingRecordChooser" class="history-record-menu hidden"></div>
        <input type="hidden" id="tastingCompareA"><input type="hidden" id="tastingCompareB">
        <div id="tastingCompareBox" class="section-gap"><div class="muted">有两条以上冲煮记录后可进行对比。</div></div>
        <div id="tastingHistoryList" class="tasting-history-list section-gap"><div class="muted">暂无冲煮历史。</div></div>
      </details>
    </section>

    <section class="card section-gap">
      <details class="compact-details" id="timelineDetails"><summary>配方版本时间线</summary>
        <div class="actions section-gap"><button class="action secondary" id="refreshTimelineBtn">刷新时间线</button><button class="action secondary" id="toggleTimelineBtn">查看全部</button></div>
        <div id="versionTimeline" class="version-timeline compact-timeline"><div class="muted">暂无记录</div></div>
      </details>
    </section>
   </main>
  </section>
 </div>
</section>


<dialog id="promoteDialog" style="border:0;border-radius:16px;padding:0;max-width:760px;width:calc(100% - 24px)">
 <div class="card">
  <h3>设为当前版本</h3>
  <div class="muted" id="promoteIntro" style="margin-top:6px">正在检查候选配方…</div>
  <div id="promoteGateBox" class="validation section-gap"></div>
  <div class="section-gap"><b>参数变化</b><div id="promoteChanges" class="promotion-change-list"></div></div>
  <div class="validation section-gap">确认后会把候选配方复制为新的原生版本，并更新当前版本指针。已有原生版本不会被覆盖或修改。</div>
  <div class="actions section-gap">
   <button class="action" id="confirmPromoteBtn">确认设为当前版本</button>
   <button class="action secondary" id="closePromoteBtn">取消</button>
  </div>
 </div>
</dialog>
<dialog id="importDialog" style="border:0;border-radius:16px;padding:0;max-width:720px;width:calc(100% - 24px)">
 <div class="card">
  <h3>导入 xBloom 配方文件</h3>
  <div class="muted" style="margin:7px 0 10px">默认导入候选配方。导入原生配方必须通过内部校验和 xBloom 校验。</div>
  <textarea id="importYaml" style="width:100%;min-height:320px;border:1px solid var(--line);border-radius:10px;padding:10px;font:12px monospace" placeholder="粘贴 YAML..."></textarea>
  <div class="actions section-gap">
    <button class="action" id="importCandidateBtn">导入候选配方</button>
    <button class="action secondary" id="importNativeBtn">导入原生配方</button>
    <button class="action secondary" id="closeImportBtn">取消</button>
  </div>
 </div>
</dialog>

<dialog id="editBeanDialog" style="border:0;border-radius:16px;padding:0;max-width:760px;width:calc(100% - 24px)">
 <div class="card mobile-dialog-card">
  <div class="dialog-head"><h3>编辑咖啡豆信息</h3><div class="muted">仅修改咖啡豆资料；不会改变豆编号、内部标识、配方版本或当前版本。</div></div>
  <form id="editBeanForm" class="section-gap">
   <div class="form-grid">
    <div class="form-field"><label>豆名 *</label><input id="editName" required></div>
    <div class="form-field"><label>烘焙商</label><input id="editRoaster"></div>
    <div class="form-field"><label>类型</label><select id="editBeanType"><option value="">未填写</option><option value="single_origin">单一产地</option><option value="blend">拼配</option></select></div>
    <div class="form-field"><label>国家 / 产区</label><input id="editOrigin"></div>
    <div class="form-field"><label>品种</label><input id="editVariety"></div>
    <div class="form-field"><label>处理法</label><select id="editProcess"><option value="">未填写</option><option value="natural">日晒</option><option value="washed">水洗</option><option value="honey">蜜处理</option><option value="anaerobic">厌氧</option><option value="fermented">发酵</option><option value="blend">拼配</option></select></div>
    <div class="form-field"><label>烘焙度</label><select id="editRoastLevel"><option value="">未填写</option><option value="light">浅烘</option><option value="medium_light">中浅烘</option><option value="medium">中烘</option><option value="medium_dark">中深烘</option><option value="dark">深烘</option></select></div>
    <div class="form-field"><label>滤杯</label><select id="editDripper"><option value="omni2">xBloom Omni Dripper 2（默认）</option><option value="v60">V60</option><option value="kalita_wave">Kalita Wave</option><option value="orea">Orea</option><option value="april">April</option><option value="other">其他滤杯</option></select><div class="dripper-note">修改滤杯只影响后续新生成的候选配方，不会重写已有原生/当前版本。</div></div>
    <div class="form-field"><label>冲煮用途</label><input id="editBrewMethod"></div>
    <div class="form-field full"><label>风味标签（用 / 分隔）</label><input id="editFlavorNotes"></div>
    <div class="form-field"><label>包装克数</label><input id="editWeight" type="number" inputmode="numeric"></div>
    <div class="form-field"><label>烘焙日期</label><input id="editRoastDate" type="date"></div>
    <div class="form-field full"><label>咖啡豆介绍</label><textarea id="editIntroduction" rows="3"></textarea></div>
    <div class="form-field full"><label>风味描述</label><textarea id="editFlavorDescription" rows="3"></textarea></div>
    <div class="form-field full"><label>冲煮方向</label><textarea id="editBrewGuidance" rows="3"></textarea></div>
    <div class="form-field full"><label>来源网页</label><input id="editSourceUrl"></div>
    <div class="form-field full"><label>备注</label><textarea id="editNotes" rows="2"></textarea></div>
   </div>
   <div class="actions section-gap"><button class="action" id="saveEditBeanBtn" type="submit">保存修改</button><button class="action secondary" id="closeEditBeanBtn" type="button">取消</button></div>
  </form>
 </div>
</dialog>

<dialog id="deleteBeanDialog" style="border:0;border-radius:16px;padding:0;max-width:620px;width:calc(100% - 24px)">
 <div class="card">
  <h3>手工删除咖啡豆</h3>
  <div id="deletePreviewBox" class="validation section-gap"></div>
  <div class="recognition-result section-gap">删除前系统会完整备份到本地回收区。此操作不会删除 xBloom 云端里的配方。</div>
  <div class="form-field section-gap"><label>请输入完整豆名确认删除</label><input id="deleteConfirmName" autocomplete="off"></div>
  <div class="form-field"><label>删除原因（可选）</label><input id="deleteReason" value="手工删除"></div>
  <div class="actions section-gap"><button class="action danger" id="confirmDeleteBeanBtn">确认删除</button><button class="action secondary" id="closeDeleteBeanBtn">取消</button></div>
 </div>
</dialog>

<dialog id="duplicateGovernanceDialog" style="border:0;border-radius:16px;padding:0;max-width:980px;width:calc(100% - 24px)">
 <div class="card duplicate-governance-card">
  <div class="dialog-head"><h3>重复咖啡豆治理</h3><div class="muted">系统只提示疑似重复，不会自动合并或删除。请人工核对后再处理。</div></div>
  <div class="actions section-gap"><button class="action secondary" id="refreshDuplicatesBtn">重新扫描</button><button class="action secondary" id="closeDuplicatesBtn">关闭</button></div>
  <div id="duplicateSummary" class="recognition-result section-gap"></div>
  <div id="duplicatePairs" class="duplicate-pairs"></div>
 </div>
</dialog>

<section id="newBeanView" class="hidden app-page">
 <button class="action secondary page-back" id="newBeanBackBtn" type="button">← 返回豆仓</button>
 <div class="card mobile-dialog-card">
  <div class="dialog-head"><h3>新增咖啡豆</h3><div class="muted" style="margin-top:6px">拍照识别 → 确认资料 → 保存豆子 → 首版配方</div><div class="intake-steps"><button type="button" class="intake-step active" id="stepPhoto">1 拍照识别</button><button type="button" class="intake-step" id="stepProfile">2 确认资料</button><div class="intake-step" id="stepSave">3 保存豆子</div><div class="intake-step" id="stepCandidate">4 首版配方</div></div></div>
  <form id="newBeanForm">
   <section class="intake-stage" id="intakePhotoPanel"><div class="capture-panel"><div class="section-label">包装图片</div><div class="capture-row" style="margin-top:8px"><label class="action" style="display:inline-flex;align-items:center;justify-content:center">📷 拍照 / 上传<input id="beanPhotoInput" name="image" type="file" accept="image/jpeg,image/png,image/webp" capture="environment" style="display:none"></label><button class="action secondary hidden" type="button" id="recognizePhotoBtn">重新识别</button><button class="action secondary" type="button" id="skipPhotoBtn">跳过识别，直接填写</button></div><img id="beanPhotoPreview" class="capture-preview" alt="咖啡包装预览"><div id="recognitionStatus" class="recognition-result hidden"></div><div id="intakeSummary" class="intake-summary hidden"></div></div></section>
   <section class="intake-stage hidden" id="intakeProfilePanel">
    <div class="intake-group"><h4>基础信息</h4><div class="form-grid intake-core"><div class="form-field"><label>豆名 *</label><input name="name" placeholder="例：Colombia Adrian Lasso" required></div><div class="form-field"><label>烘焙商</label><input name="roaster" placeholder="例：Axil Coffee"></div><div class="form-field"><label>类型</label><select name="bean_type"><option value="">请选择</option><option value="single_origin">单一产地</option><option value="blend">拼配</option></select></div><div class="form-field"><label>国家 / 产区</label><input name="origin" placeholder="例：Colombia"></div><div class="form-field"><label>品种</label><input name="variety" placeholder="例：Pink Bourbon"></div><div class="form-field"><label>处理法</label><select name="process"><option value="">请选择</option><option value="natural">日晒 Natural</option><option value="washed">水洗 Washed</option><option value="honey">蜜处理 Honey</option><option value="anaerobic">厌氧 Anaerobic</option><option value="fermented">发酵 Fermented</option><option value="blend">拼配</option></select></div></div></div>
    <div class="intake-group"><h4>冲煮相关</h4><div class="form-grid intake-core"><div class="form-field"><label>烘焙度</label><select name="roast_level"><option value="">包装未注明 / 待确认</option><option value="light">浅烘</option><option value="medium_light">中浅烘</option><option value="medium">中烘</option><option value="medium_dark">中深烘</option><option value="dark">深烘</option></select></div><div class="form-field"><label>默认冲煮滤杯</label><select name="dripper"><option value="omni2">xBloom Omni Dripper 2（默认）</option></select><div class="dripper-note">这里只设置默认值；每次冲煮仍可单独选择滤杯。</div></div><div class="form-field"><label>冲煮用途</label><input name="brew_method" placeholder="例：filter / espresso"></div><div class="form-field"><label>烘焙日期</label><input name="roast_date" type="date"></div><div class="form-field"><label>包装克数</label><input name="weight_g" type="number" inputmode="numeric" placeholder="250"></div></div><div id="newBeanRestingPreview" class="resting-live-hint">填写烘焙日期与烘焙度后，将预估养豆状态。</div></div>
    <div class="intake-group"><h4>风味标签</h4><div class="form-field full"><input name="flavor_notes" placeholder="Lime / Apricot / Allspice / Mandarin"></div></div>
    <details class="intake-group intake-more"><summary>更多信息</summary><div class="form-grid" style="margin-top:10px"><div class="form-field full"><label>咖啡豆介绍</label><textarea name="introduction" rows="3" placeholder="识别后自动生成，可修改"></textarea></div><div class="form-field full"><label>风味描述</label><textarea name="flavor_description" rows="3" placeholder="识别后自动生成，可修改"></textarea></div><div class="form-field full"><label>冲煮方向</label><textarea name="brew_guidance" rows="3" placeholder="包装信息 + 后续人工补充"></textarea></div><div class="form-field full"><label>来源网页（可选）</label><input name="source_url" inputmode="url" placeholder="https://..."></div><div class="form-field full"><label>备注</label><textarea name="notes" rows="2" placeholder="其它包装信息或人工备注"></textarea></div></div></details>
    <div class="intake-primary-actions"><button class="action" type="button" id="saveAndGenerateBtn">保存并生成首版候选配方</button><button class="action secondary" type="submit" id="saveOnlyBeanBtn">仅保存咖啡豆</button></div>
   </section>
  </form>
 </div>
</section>
<dialog id="initialDialog" style="border:0;border-radius:16px;padding:0;max-width:520px;width:calc(100% - 24px)">
 <div class="card">
  <h3>生成首版候选配方</h3>
  <div class="muted" style="margin:7px 0 12px">这是起始候选配方，不会自动成为当前版本。</div>
  <select id="initialStyle" style="width:100%;padding:10px;border:1px solid var(--line);border-radius:9px">
    <option value="balanced">平衡</option>
    <option value="sweet">偏甜</option>
    <option value="bright">明亮</option>
  </select>
  <select id="initialDripper" style="width:100%;padding:10px;margin-top:8px;border:1px solid var(--line);border-radius:9px">
    <option value="omni2">滤杯：xBloom Omni Dripper 2（默认）</option><option value="v60">滤杯：V60</option><option value="kalita_wave">滤杯：Kalita Wave</option><option value="orea">滤杯：Orea</option><option value="april">滤杯：April</option><option value="other">滤杯：其他</option>
  </select>
  <input id="initialFocus" placeholder="想突出什么，用 / 分隔，例如：芒果/莓果" style="width:100%;padding:10px;margin-top:8px;border:1px solid var(--line);border-radius:9px">
  <div class="actions section-gap"><button class="action" id="createInitialBtn">生成</button><button class="action secondary" id="closeInitialBtn">取消</button></div>
 </div>
</dialog>
<dialog id="tastingDialog" style="border:0;border-radius:16px;padding:0;max-width:620px;width:calc(100% - 24px)">
 <div class="card">
  <h3>记录冲煮反馈</h3>
  <div class="muted" style="margin:7px 0 12px">请选择本次最明显的冲煮表现，可多选，最多 3 项。系统会先做症状组合仲裁，再决定是否生成候选；Candidate 仍最多调整 1–2 个变量。</div>
  <div class="form-field"><label>本次使用滤杯</label><select id="tasteDripper"></select><div class="dripper-note">记录会保存本次滤杯快照；生成的 Candidate 继承该滤杯。</div></div>
  <div class="tasting-multi">
    <button type="button" class="multi-toggle" id="tasteSymptomToggle"><span id="tasteSymptomToggleText">请选择冲煮问题（可多选）</span><span>▾</span></button>
    <div id="tasteSymptomMenu" class="multi-menu hidden"></div>
    <div id="tasteSymptomTags" class="multi-tags"></div>
    <input id="tasteSymptom" type="hidden">
  </div>
  <textarea id="tasteNotes" placeholder="备注，一行一条" style="width:100%;min-height:100px;margin-top:8px;border:1px solid var(--line);border-radius:9px;padding:10px"></textarea>
  <div class="actions section-gap"><button class="action secondary" id="saveTastingOnlyBtn">仅保存反馈</button><button class="action" id="saveTastingBtn">保存反馈并生成调整方案</button><button class="action secondary" id="closeTastingBtn">取消</button></div>
  <div class="workflow-note">“仅保存反馈”不会创建 Candidate；“保存反馈并生成调整方案”会在规则一致时生成 Candidate。冲突症状不会强行叠加调参。</div>
 </div>
</dialog>
<section id="settingsView" class="hidden app-page">
 <button class="action secondary settings-back" id="settingsBackBtn" type="button">← 返回豆仓</button>
 <div class="card mobile-dialog-card">
  <div class="dialog-head">
    <h3>设置</h3>
    <div class="tabs" style="margin-top:10px">
      <button class="tab active" id="settingsAiTab" type="button">人工智能设置</button>
      <button class="tab" id="settingsCloudTab" type="button">xBloom 云端</button>
      <button class="tab" id="settingsStatusTab" type="button">状态</button>
      <button class="tab" id="settingsRestingTab" type="button">养豆规则</button>
      <button class="tab" id="settingsDripperTab" type="button">滤杯管理</button>
    </div>
  </div>

  <section id="settingsAiPane">
    <div class="settings-row">
      <div class="form-field"><label>Base URL</label><input id="cfgBaseUrl" placeholder="https://..."></div>
      <div class="form-field"><label>Model</label><input id="cfgModel" placeholder="模型名"></div>
      <div class="form-field"><label>API Key</label><input id="cfgApiKey" type="password" placeholder="留空则保持现有密钥不变"></div>

      <div class="switch-row"><span>启用人工智能</span><input id="cfgEnabled" type="checkbox"></div>
      <div class="switch-row"><span>人工智能用于包装识别</span><input id="cfgRecognition" type="checkbox" checked></div>
      <div class="switch-row"><span>人工智能用于冲煮建议 / 自动候选</span><input id="cfgBrewAdvice" type="checkbox" checked></div>

      <div id="settingsHint" class="recognition-result">保存后立即生效。</div>
    </div>

    <div class="dialog-footer">
      <div class="actions">
        <button class="action" id="saveSettingsBtn" type="button">保存人工智能设置</button>
        <button class="action secondary" id="closeSettingsBtn" type="button">返回豆仓</button>
      </div>
    </div>
  </section>

  <section id="settingsCloudPane" class="hidden">
    <div class="settings-row">
      <div class="form-field">
        <label>xBloom 账号邮箱</label>
        <input id="cfgCloudEmail" type="email" autocomplete="username" placeholder="your@email.com">
      </div>
      <div class="form-field">
        <label>xBloom 账号密码</label>
        <input id="cfgCloudPassword" type="password" autocomplete="current-password" placeholder="留空则保持现有密码不变">
      </div>

      <div id="cloudSettingsHint" class="recognition-result">
        Cloud 凭据仅保存在服务器端；前端不会读取已保存的密码。Token 缺失或失效时会自动登录并重试一次。
      </div>

      <div class="validation">
        <div class="row"><span>配置状态</span><span id="cloudCfgStatus">—</span></div>
        <div class="row"><span>账号</span><span id="cloudCfgEmail">—</span></div>
        <div class="row"><span>来源</span><span id="cloudCfgSource">—</span></div>
        <div class="row"><span>xbloom CLI</span><span id="cloudCfgCli">—</span></div>
      </div>

      <div class="actions">
        <button class="action" id="saveCloudSettingsBtn" type="button">保存云端账号</button>
        <button class="action secondary" id="testCloudLoginBtn" type="button">测试登录</button>
        <button class="action secondary" id="clearCloudSettingsBtn" type="button">清除网页配置</button>
        <button class="action secondary" id="closeCloudSettingsBtn" type="button">返回豆仓</button>
      </div>
    </div>
  </section>

  <section id="settingsStatusPane" class="hidden">
    <div class="settings-row">
      <div class="validation">
        <b>系统状态</b>
        <div class="row"><span>版本</span><span id="statusVersion">—</span></div>
        <div class="row"><span>Workflow</span><span id="statusWorkflow">—</span></div>
        <div class="row"><span>External Validator</span><span id="statusValidator">—</span></div>
        <div class="row"><span>xBloom 云端</span><span id="statusCloud">—</span></div>
        <div class="row"><span>人工智能</span><span id="statusAI">—</span></div>
      </div>

      <div class="validation">
        <b>人工智能建议观测</b>
        <div class="row"><span>AI 尝试</span><span id="statusAiAttempts">0</span></div>
        <div class="row"><span>AI 通过</span><span id="statusAiAccepted">0</span></div>
        <div class="row"><span>规则回退</span><span id="statusAiFallbacks">0</span></div>
        <div class="row"><span>仲裁前置拦截</span><span id="statusAiBlocks">0</span></div>
        <div class="row"><span>最近拒绝原因</span><span id="statusAiLastReject">暂无</span></div>
      </div>

      <div class="validation">
        <b>系统说明</b>
        <div class="muted" style="margin-top:8px;line-height:1.6">
          Native Recipe SSOT → Internal Validation → xbloom validate → Current
        </div>
      </div>

      <div class="actions">
        <button class="action secondary" id="statusRefreshBtn" type="button">刷新状态</button>
        <button class="action secondary" id="backupBtn" type="button">备份数据</button>
        <button class="action secondary" id="closeSettingsStatusBtn" type="button">返回豆仓</button>
      </div>
    </div>
  </section>

  <section id="settingsRestingPane" class="hidden">
    <div class="settings-row">
      <div class="muted" style="margin-bottom:10px;line-height:1.6">系统根据烘焙日期和烘焙度自动判断「养豆 / 在喝」。人工归档优先级最高；未填写烘焙度固定按 10 天计算。</div>
      <div class="resting-summary"><span>规则来源</span><span id="restingSource" class="status ok">—</span></div>
      <div class="resting-rules-grid" id="restingRows">
        <div class="resting-rule-row"><span>浅烘</span><input id="resting_light" type="number" min="0" max="60"><span>天</span></div><div class="resting-rule-row"><span>中浅烘</span><input id="resting_medium_light" type="number" min="0" max="60"><span>天</span></div><div class="resting-rule-row"><span>中烘</span><input id="resting_medium" type="number" min="0" max="60"><span>天</span></div><div class="resting-rule-row"><span>中深烘</span><input id="resting_medium_dark" type="number" min="0" max="60"><span>天</span></div><div class="resting-rule-row"><span>深烘</span><input id="resting_dark" type="number" min="0" max="60"><span>天</span></div><div class="resting-rule-row"><span>未填写烘焙度</span><input id="resting_unknown" type="number" value="10" disabled title="系统固定 10 天"><span>天</span></div>
      </div>
      <div id="restingRulePreview" class="resting-preview">浅烘：0–14 天养豆，第 15 天起进入「在喝」。</div>
      <div id="restingHint" class="recognition-result">保存后立即生效。</div>
      <div class="actions"><button class="action" id="saveRestingBtn" type="button">保存规则</button><button class="action secondary" id="resetRestingBtn" type="button">恢复默认</button></div>
    </div>
  </section>

  <section id="settingsDripperPane" class="hidden">
    <div class="settings-row">
      <div class="muted" style="margin-bottom:10px;line-height:1.6">
        管理可用于新 Bean / 新 Candidate 的滤杯。系统预置只能停用；自定义滤杯在没有 Bean/配方引用时可以删除。历史配方继续保留当时的滤杯 ID 与 revision。
      </div>
      <div class="validation">
        <b>新增 / 编辑自定义滤杯</b>
        <div class="form-grid" style="margin-top:10px">
          <div class="form-field"><label>品牌</label><input id="dripperBrand" placeholder="例如 Origami"></div>
          <div class="form-field"><label>型号</label><input id="dripperModel" placeholder="例如 Air S"></div>
          <div class="form-field"><label>结构</label><select id="dripperShape"><option value="conical">锥形</option><option value="flat">平底</option><option value="other">其他</option></select></div>
          <div class="form-field"><label>流速特征</label><select id="dripperFlowClass"><option value="slow">慢</option><option value="medium" selected>中</option><option value="fast">快</option><option value="ultra_fast">超快</option></select></div>
        </div>
        <details class="dripper-advanced"><summary>高级参数</summary>
          <div class="form-grid" style="margin-top:10px">
            <div class="form-field"><label>研磨偏移</label><input id="dripperGrindOffset" type="number" step="0.1" value="0"></div>
            <div class="form-field"><label>水温偏移 ℃</label><input id="dripperTempOffset" type="number" step="1" value="0"></div>
            <div class="form-field"><label>闷蒸时间偏移 秒</label><input id="dripperBloomOffset" type="number" step="1" value="0"></div>
            <div class="form-field"><label>水流偏移 ml/s</label><input id="dripperFlowOffset" type="number" step="0.05" value="0"></div>
          </div>
        </details>
        <input id="dripperEditKey" type="hidden">
        <div class="actions" style="margin-top:10px"><button class="action" id="saveDripperBtn" type="button">保存滤杯</button><button class="action secondary" id="resetDripperEditorBtn" type="button">清空</button></div>
      </div>
      <div class="dripper-registry-list" id="dripperRegistryList"></div>
      <div class="actions"><button class="action secondary" id="closeDripperSettingsBtn" type="button">返回豆仓</button></div>
    </div>
  </section>
 </div>
</section>
<div class="bottom-nav"><button id="navAddBtn">新增</button><button id="navWarehouseBtn" class="active">豆仓</button><button id="navSyncBtn">同步</button><button id="navSettingsBtn">设置</button></div>
<!-- v0.1 iOS shim: server address editor (must be placed before the JS block so bindings resolve) -->
<div id="iosServerBox" style="position:fixed;left:12px;bottom:84px;z-index:9999;background:#fff;border:1px solid var(--line);border-radius:12px;padding:10px 12px;box-shadow:0 4px 14px rgba(0,0,0,.14);display:none">
  <div style="font-size:12px;font-weight:800;margin-bottom:6px">服务器地址</div>
  <input id="iosServerInput" style="width:230px;padding:7px 9px;border:1px solid var(--line);border-radius:8px;font:inherit;font-size:13px" placeholder="http://192.168.50.22:8088">
  <div style="display:flex;gap:6px;margin-top:8px">
    <button id="iosServerSave" class="action" style="padding:6px 10px;font-size:12px">保存并重载</button>
    <button id="iosServerClose" class="secondary" style="padding:6px 10px;font-size:12px">取消</button>
  </div>
</div>
<button id="iosServerBtn" title="服务器设置" style="position:fixed;left:12px;bottom:66px;z-index:9999;border:1px solid var(--line);background:#fff;border-radius:999px;padding:6px 10px;font-size:12px;font-weight:800;cursor:pointer;box-shadow:0 2px 8px rgba(0,0,0,.12)">🛜 服务器</button>
<script>
const $=s=>document.querySelector(s);
/* ============ v0.1 iOS Capacitor shim (DERIVED artifact — never applied to v2.3.7 server baseline) ============ */
var API_BASE=(localStorage.getItem("xbloom_api_base")||"http://192.168.50.22:8088").replace(/\/+$/,"");
function absURL(u){ if(!u||/^[a-z][a-z0-9+.\-]*:/i.test(u)) return u; return API_BASE+u; }
/* ============ end v0.1 shim ============ */
let beans=[],selected=null,selectedBean=null,selectedRecipeContext={},currentRecipe=null,currentVersion=null,currentReadiness=null,activeRule=null,nextRecipe=null,currentFilter="drinking";
// Dripper precedence contract: session dripper > recipe version dripper > bean default dripper > omni2

const rules=[
{id:"sharp",t:"酸太尖 / 发涩",d:"刺激性酸、生感",n:{grindDelta:2,tempDelta:-1,bloomDelta:5},r:"调粗2格、降温1℃，闷蒸延长5秒。"},
{id:"thin",t:"酸 + 薄 + 不甜",d:"水感重、尾韵短",n:{grindDelta:-1.5,bloomDelta:5},r:"更接近萃取不足：调细1–2格，水温先保持。"},
{id:"bitter",t:"苦 / 涩 / 发干",d:"尾段苦涩明显",n:{grindDelta:2,tempDelta:-1,tailFactor:.9},r:"调粗、降温，并减少约10%尾段水量。"},
{id:"ferment",t:"发酵味太重",d:"酒感发脏、闷酵",n:{grindDelta:2,tempDelta:-2,tailFlowDelta:.3},r:"降低温度并提高尾段流速。"},
{id:"weak",t:"太淡 / 水感重",d:"香气弱、结构松",n:{grindDelta:-1.5,tempDelta:1,waterFactor:.97},r:"先提高萃取；优先调细研磨。"},
{id:"heavy",t:"太浓 / 闷",d:"层次黏在一起",n:{grindDelta:1.5,tempDelta:-1,waterFactor:1.025},r:"小幅降低萃取并增加水量。"},
{id:"sweet",t:"甜感不足",d:"成熟水果甜度不够",n:{tempDelta:-1,bloomDelta:7},r:"研磨先不动，用降温与延长闷蒸提高甜感。"},
{id:"aroma",t:"香气不足",d:"杯子干净但偏平",n:{grindDelta:-1,tempDelta:1,main1FlowDelta:.15},r:"稍细研磨、升温并略提高Main 1流速。"}
];

async function api(url,opt){
 const r=await fetch(absURL(url),opt);
 if(!r.ok){
   let msg=await r.text();
   try{const j=JSON.parse(msg);msg=typeof j.detail==="string"?j.detail:JSON.stringify(j.detail)}catch(e){}
   throw new Error(msg);
 }
 return r.json();
}
function esc(s){return String(s??"").replace(/[&<>"]/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[m]))}
function labelRoast(v){return({light:"浅烘",medium_light:"中浅烘",medium:"中烘",medium_dark:"中深烘",dark:"深烘"}[v]||v||"")}
function stateBadgeText(st){const map={XBLOOM_READY:"可用于 xBloom",INTERNAL_FAIL:"内部校验失败",PENDING_EXTERNAL:"等待 xBloom 校验",EXTERNAL_FAIL:"xBloom 校验失败",NO_RECIPE:"暂无配方",SUCCESS:"成功",FAILED:"失败",CLEARED:"已清除"};return map[st]||st||"—";}
function stateBadge(r){
 if(!r)return '<span class="status warn">暂无配方</span>';
 const st=r.state;
 if(st==="XBLOOM_READY")return '<span class="status ok">可用于 xBloom ✓</span>';
 if(st==="INTERNAL_FAIL")return '<span class="status bad">内部校验失败</span>';
 if(st==="PENDING_EXTERNAL")return '<span class="status warn">内部通过 · 等待 xBloom 校验</span>';
 if(st==="EXTERNAL_FAIL")return '<span class="status bad">xBloom 校验失败</span>';
 return `<span class="status warn">${esc(st)}</span>`;
}
function renderWarehouse(list){
 $("#stats").textContent=`共 ${list.length} 款豆`;
 $("#warehouse").innerHTML=list.map(b=>`<article class="bean-card" data-id="${esc(b.bean_id)}">
 ${b.image_url?`<img class="bean-img" src="${esc(absURL(b.image_url))}" alt="${esc(b.name)}包装">`:`<div class="img-placeholder">暂无图片</div>`}
 <div class="bean-body"><div class="bean-title"><b>${esc(b.sample_no)} · ${esc(b.name)}</b><span class="muted">${esc(labelRoast(b.roast_level))}</span></div>
 <div class="muted">${esc(b.roaster||"")}</div><div class="tags">${(b.flavor_notes||[]).map(x=>`<span class="tag">${esc(x)}</span>`).join("")}</div>
 <div class="intro">${esc(b.introduction||b.flavor_description||"暂无介绍")}</div>
 <div class="muted" style="margin-top:8px">${b._summary&&b._summary.favorite?"★ ":""}原生配方 ${esc(b._summary?.native_count||0)} · 候选 ${esc(b._summary?.candidate_count||0)} · 冲煮反馈 ${esc(b._summary?.tasting_count||0)}</div>
 <div class="muted" style="margin-top:4px">${b._summary?.cloud?.synced?"☁ 云端已同步":"☁ 待同步"}${b._summary?.cloud?.slot?` · 槽位 ${esc(b._summary.cloud.slot)}`:""}${warehouseLifecycleHTML(b)}</div></div></article>`).join("");
 document.querySelectorAll(".bean-card").forEach(x=>x.onclick=()=>openBean(x.dataset.id));
}
function warehouseLifecycleHTML(b){
 const s=b._summary||{};
 if(s.warehouse_state==="resting")return ` · <span class="lifecycle-badge resting">养豆至 ${esc(s.resting_until||"—")}</span>`;
 if(s.warehouse_state==="archived")return ' · <span class="lifecycle-badge archived">已归档</span>';
 return ' · <span class="lifecycle-badge">在喝</span>';
}
async function loadBeans(){beans=await api("/api/beans");applyWarehouseFilter()}

function applyWarehouseFilter(){
 const q=$("#search").value.trim().toLowerCase();
 const filtered=beans.filter(b=>{
   const text=[b.name,b.roaster,b.process,b.roast_level,b.introduction,b.flavor_description,...(b.flavor_notes||[])].join(" ").toLowerCase();
   if(q && !text.includes(q))return false;
   const s=b._summary||{};
   if(currentFilter!=="all"&&(s.warehouse_state||"drinking")!==currentFilter)return false;
   return true;
 });
 renderWarehouse(filtered);
 document.querySelectorAll(".filterBtn").forEach(x=>x.classList.toggle("active",x.dataset.filter===currentFilter));
}
$("#search").oninput=applyWarehouseFilter;
document.querySelectorAll(".filterBtn").forEach(b=>b.onclick=()=>{currentFilter=b.dataset.filter;applyWarehouseFilter()});


function recipeRows(r){
 if(!r)return [];
 const p=r.pours||[],b=p[0]||{},m=p[1]||{},t=p[p.length-1]||{};
 return [["粉量",r.dose_g+"g"],["研磨",r.grind],["粉水比","1:"+r.ratio],["首段水温",(b.temp_c??r.temp_c)+"℃"],["闷蒸",(b.pause_s??0)+"s"],["分段",p.map(x=>x.ml+"ml").join(" + ")],["Main1流速",(m.flow_ml_s??"—")+" ml/s"],["尾段流速",(t.flow_ml_s??"—")+" ml/s"]];
}
function rowsHTML(rows,highlight=false){return rows.map(([k,v])=>`<div class="row"><span>${esc(k)}</span><span class="${highlight?"new":""}">${esc(v)}</span></div>`).join("")}

function makeNext(rule){
 if(!currentRecipe)return null;
 const r=JSON.parse(JSON.stringify(currentRecipe));
 const p=r.pours||[],b=p[0],m=p[1]||p[0],t=p[p.length-1];
 if(rule.n.grindDelta)r.grind=Math.round((Number(r.grind)+rule.n.grindDelta)*10)/10;
 if(rule.n.tempDelta){r.temp_c=Math.round(Number(r.temp_c)+rule.n.tempDelta);if(b)b.temp_c=Math.round(Number(b.temp_c??r.temp_c)+rule.n.tempDelta)}
 if(rule.n.bloomDelta&&b)b.pause_s=Math.round(Number(b.pause_s||0)+rule.n.bloomDelta);
 if(rule.n.tailFlowDelta&&t)t.flow_ml_s=Math.round((Number(t.flow_ml_s||0)+rule.n.tailFlowDelta)*100)/100;
 if(rule.n.main1FlowDelta&&m)m.flow_ml_s=Math.round((Number(m.flow_ml_s||0)+rule.n.main1FlowDelta)*100)/100;
 if(rule.n.tailFactor&&t)t.ml=Math.max(1,Math.round(Number(t.ml)*rule.n.tailFactor));
 if(rule.n.waterFactor&&t){const oldTotal=p.reduce((sum,x)=>sum+Number(x.ml||0),0),newTotal=Math.round(oldTotal*rule.n.waterFactor),diff=newTotal-oldTotal;t.ml=Math.max(1,Math.round(Number(t.ml)+diff));}
 const total=p.reduce((sum,x)=>sum+Number(x.ml||0),0);
 if(Number(r.dose_g)>0)r.ratio=Math.round((total/Number(r.dose_g))*1000)/1000;
 return r;
}

function validationHTML(r){
 if(!r)return '<span class="muted">无校验结果</span>';
 const i=r.internal||{};
 const e=r.external||{};
 return `<div><b>配方校验</b> ${stateBadge(r)}</div>
 <div class="validation-grid">
  <div class="metric"><span class="muted">内部校验</span><br><b style="color:${i.valid?'var(--ok)':'var(--bad)'}">${i.valid?'通过':'失败'}</b></div>
  <div class="metric"><span class="muted">理论总水量</span><br><b>${esc(i.expected_water_ml??'—')}ml</b></div>
  <div class="metric"><span class="muted">分段合计</span><br><b>${esc(i.actual_pours_ml??'—')}ml</b></div>
  <div class="metric"><span class="muted">差值</span><br><b>${i.difference_ml==null?'—':(i.difference_ml>0?'+':'')+esc(i.difference_ml)+'ml'}</b></div>
 </div>
 ${i.errors&&i.errors.length?`<div style="margin-top:8px;color:var(--bad);font-size:12px">${i.errors.map(x=>'• '+esc(x)).join('<br>')}</div>`:''}
 <div class="muted" style="margin-top:8px">外部 xBloom 校验：${esc(e.status||'—')}</div>`;
}


function renderCloudWorkflow(state){
 const s=state||{};
 $("#cloudSyncBadge").textContent=s.synced?"已同步":"待同步";
 $("#cloudSyncBadge").className="status "+(s.synced?"ok":"warn");
 $("#cloudRecipeName").textContent=s.cloud_name||"—";
 $("#cloudLastSync").textContent=s.last_sync||"—";
 $("#cloudAppSlot").textContent=s.slot?`槽位 ${s.slot}`:"未分配";
}



let syncSnapshot=null;

function setBottomNavActive(id){
 document.querySelectorAll(".bottom-nav button").forEach(b=>b.classList.remove("active"));
 const el=$("#"+id);
 if(el)el.classList.add("active");
}

function showDetailPane(name){
 [["info","detailInfoPane","detailInfoTab"],["extraction","detailExtractionPane","detailExtractionTab"],["adjust","detailAdjustPane","detailAdjustTab"]].forEach(([n,p,t])=>{
   const active=n===name;
   $("#"+p).classList.toggle("hidden",!active);
   $("#"+t).classList.toggle("active",active);
 });
}

function showWarehouseView(){
 $("#newBeanView").classList.add("hidden");
 $("#settingsView").classList.add("hidden");
 $("#warehouseView").classList.remove("hidden");
 $("#syncView").classList.add("hidden");
 $("#detailView").classList.add("hidden");
 setBottomNavActive("navWarehouseBtn");
 window.scrollTo({top:0,behavior:"smooth"});
}

function syncBeanLabel(row){
 const version=row.current_version?`v${row.current_version}`:"无当前版本";
 const ready=row.readiness?.ready?"可用":(row.readiness?.state||"未就绪");
 return `${row.sample_no||""} ${row.name||row.bean_id} · ${version} · ${ready}`;
}

function syncOptionHTML(row,selectedId){
 const selected=row.bean_id===selectedId?" selected":"";
 const disabled=(!row.current_version||!row.readiness?.ready)?" disabled":"";
 return `<option value="${esc(row.bean_id)}"${selected}${disabled}>${esc(syncBeanLabel(row))}</option>`;
}

function renderSyncSlot(slot){
 const select=$("#syncSelect"+slot);
 const info=$("#syncInfo"+slot);
 const badge=$("#syncState"+slot);
 const row=(syncSnapshot?.beans||[]).find(x=>x.bean_id===select.value);

 if(!row){
   badge.textContent="未分配";
   badge.className="status warn";
   info.textContent="空槽；应用后会清除网站中的该槽位标记。";
   return;
 }

 const cloud=row.cloud||{};
 if(!row.readiness?.ready){
   badge.textContent=stateBadgeText(row.readiness?.state||"未就绪");
   badge.className="status bad";
 }else if(cloud.synced){
   badge.textContent="已同步";
   badge.className="status ok";
 }else{
   badge.textContent="待同步";
   badge.className="status warn";
 }

 info.innerHTML=`当前版本 ${esc(row.current_version?`v${row.current_version}`:"—")} · ${esc(row.readiness?.state||"—")}<br>${cloud.synced?`☁ ${esc(cloud.cloud_name||"Cloud Synced")}`:"☁ 尚未同步当前版本"}`;
}

function validateSyncSelections(showAlert=true){
 const values=["A","B","C"].map(s=>$("#syncSelect"+s).value).filter(Boolean);
 const duplicate=values.find((v,i)=>values.indexOf(v)!==i);
 if(duplicate){
   if(showAlert)alert("同一只咖啡豆不能同时占用多个 Slot。");
   return false;
 }
 return true;
}

function renderSyncCenter(snapshot){
 syncSnapshot=snapshot;
 const cloud=snapshot.cloud||{};
 $("#syncCloudStateLabel").textContent=cloud.status==="READY"?"已连接":"未连接";
 $("#syncCloudStateLabel").style.color=cloud.status==="READY"?"var(--ok)":"var(--warn)";
 $("#syncCloudDot").className="sync-dot"+(cloud.status==="READY"?" ok":"");
 $("#syncCloudAccount").textContent=cloud.email||"未配置账号";

 for(const slot of ["A","B","C"]){
   const selectedId=snapshot.slots?.[slot]?.bean_id||"";
   const options=(snapshot.beans||[]).map(row=>syncOptionHTML(row,selectedId)).join("");
   $("#syncSelect"+slot).innerHTML=`<option value="">— 未分配 —</option>${options}`;
   $("#syncSelect"+slot).value=selectedId;
   renderSyncSlot(slot);
 }

 if((snapshot.warnings||[]).length){
   $("#syncResultBox").classList.remove("hidden");
   $("#syncResultRows").innerHTML=(snapshot.warnings||[]).map(w=>`<div class="muted">${esc(w)}</div>`).join("");
 }
}

async function loadSyncCenter(){
 try{
   const snapshot=await api("/api/sync-center");
   renderSyncCenter(snapshot);
   const now=new Date(); $("#syncLastRefresh").textContent=`最近刷新：${now.toLocaleTimeString([], {hour:"2-digit",minute:"2-digit"})}`;
 }catch(e){
   alert("读取同步中心失败："+e.message);
 }
}

async function openSyncCenter(){
 $("#newBeanView").classList.add("hidden");
 $("#settingsView").classList.add("hidden");
 $("#warehouseView").classList.add("hidden");
 $("#detailView").classList.add("hidden");
 $("#syncView").classList.remove("hidden");
 setBottomNavActive("navSyncBtn");
 window.scrollTo({top:0,behavior:"smooth"});
 await loadSyncCenter();
}

function syncResultHTML(result){
 const name=result.name||result.bean_id||"—";
 let detail="";
 let cls="ok";
 if(result.status==="SUCCESS"){
   detail=result.sync_action==="NOOP_ALREADY_SYNCED"?"当前版本已在云端，无需重新上传":"云端同步成功";
 }else if(result.status==="CLEARED"){
   detail="网站槽位标记已清除";
 }else{
   cls="bad";
   const reason=typeof result.reason==="string"?result.reason:JSON.stringify(result.reason||"同步失败");
   detail=reason;
 }
 return `<div class="sync-result-row"><b>${esc(result.slot||"—")}</b><div>${esc(name)}<br><span class="muted">${esc(detail)}</span></div><span class="status ${cls}">${esc(result.status||"—")}</span></div>`;
}

async function applySyncCenter(){
 if(!validateSyncSelections(true))return;

 const payload={slots:{
   A:$("#syncSelectA").value||null,
   B:$("#syncSelectB").value||null,
   C:$("#syncSelectC").value||null
 }};

 if(!confirm("同步所选当前原生配方到 xBloom Cloud，并更新网站 A/B/C 标记？\n\n不会直接写入机器；完成后仍需在 xBloom 应用中分配相同 A/B/C。"))return;

 const btn=$("#syncApplyBtn");
 const old=btn.textContent;
 btn.disabled=true;
 btn.textContent="同步中…";
 try{
   const r=await api("/api/sync-center/apply",{
     method:"POST",
     headers:{"Content-Type":"application/json"},
     body:JSON.stringify(payload)
   });
   $("#syncResultBox").classList.remove("hidden");
   $("#syncResultRows").innerHTML=(r.results||[]).map(syncResultHTML).join("");
   if(r.snapshot)renderSyncCenter(r.snapshot);
   await loadBeans();

   if(r.ok){
     alert("同步完成。请在 xBloom App 中确认 A / B / C 槽位并写入机器。");
   }else{
     alert("部分或全部 Slot 未完成，请查看同步结果。");
   }
 }catch(e){
   alert("同步中心执行失败："+e.message);
 }finally{
   btn.disabled=false;
   btn.textContent=old;
 }
}


function zhBeanType(v){
 const x=String(v||"").trim().toLowerCase();
 const map={"blend":"拼配","single origin":"单一产区","single-origin":"单一产区","single bean":"单品豆","single":"单品豆"};
 return map[x]||v||"未填写";
}
function displayValue(v,empty="未填写"){return (v===null||v===undefined||v===""||v==="—")?empty:v}
function zhDripper(v){const key=String(v||"omni2").toLowerCase();const cached=(dripperRegistryCache||[]).find(x=>x.key===key);if(cached)return dripperOptionLabel(cached);const m={omni2:"xBloom Omni Dripper 2",v60:"Hario V60",kalita_wave:"Kalita Wave",orea:"Orea",april:"April",origami_pinn:"ORIGAMI Pinn Dripper",other:"其他滤杯"};return m[key]||v||"xBloom Omni Dripper 2"}
function renderExtractionCards(recipe,source="current",candidateVersion=null,context=null){
 const state=$("#extractionRecipeState");
 if(!recipe){
   $("#extractMetricCards").innerHTML='<div class="muted" style="grid-column:1/-1;padding:10px">尚未生成萃取配方。</div>';
   $("#pourCards").innerHTML='<div class="muted">暂无注水数据</div>';
   $("#extractionSourceHint").textContent="尚无当前版本或候选配方";
   state.classList.remove("hidden");
   state.innerHTML='<b>还没有萃取配方</b><div class="muted" style="margin-top:6px">可以直接在这里生成首版候选配方。生成后仍需人工校验并设为当前版本。</div><div class="actions section-gap"><button class="action" id="emptyGenerateRecipeBtn">生成首版萃取配方</button></div>';
   $("#generateExtractionBtn").style.display="";
   $("#emptyGenerateRecipeBtn").onclick=openInitialRecipeDialog;
   return;
 }
 const isCandidate=source==="candidate";
 const recipeDripper=context?.dripper||selectedBean?.dripper||"omni2";
 $("#extractionSourceHint").textContent=(isCandidate?`候选配方 v${candidateVersion}（尚未设为当前版本）`:`当前版本 v${currentVersion}`)+` · 滤杯 ${zhDripper(recipeDripper)}`;
 if($("#extractionDripperSelect")){ $("#extractionDripperSelect").dataset.current=recipeDripper; $("#extractionDripperSelect").value=recipeDripper; }
 $("#generateExtractionBtn").style.display=recipe?"none":"";
 if(isCandidate){state.classList.remove("hidden");state.innerHTML=`<b>候选配方 v${esc(candidateVersion)}</b><div class="muted" style="margin-top:6px">首版配方已经生成，但不会自动成为当前版本。请确认参数和校验结果后，再到版本 / 历史中设为当前版本。</div>`;}else state.classList.add("hidden");
 const pours=recipe.pours||[];
 const total=pours.reduce((sum,p)=>sum+Number(p.ml||0),0);
 const rpm=recipe.rpm??(pours.find(p=>p.rpm!=null)?.rpm);
 const temp=recipe.temp_c??(pours[0]?.temp_c);
 const cards=[["粉量",recipe.dose_g!=null?recipe.dose_g+"g":"未填写"],["研磨度",displayValue(recipe.grind)],["转速",rpm!=null?rpm:"未填写"],["水温",temp!=null?temp+"℃":"未填写"],["粉水比",recipe.ratio!=null?"1:"+recipe.ratio:"未填写"],["总水量",total?total+"ml":"未填写"]];
 $("#extractMetricCards").innerHTML=cards.map(([k,v])=>`<div class="extract-metric-card"><span>${esc(k)}</span><b>${esc(v)}</b></div>`).join("");
 $("#pourCards").innerHTML=pours.map((p,i)=>{const name=i===0?"闷蒸":`第 ${i+1} 段注水`;const t=p.temp_c??recipe.temp_c;const seconds=p.pause_s??p.duration_s??0;const flow=p.flow_ml_s;const pattern=p.pattern||p.pour_pattern;return `<div class="pour-step-card"><div class="pour-step-title"><b>${esc(name)}</b></div><div class="pour-step-water">${esc(p.ml??"—")}ml</div><div class="pour-visual"></div><div class="pour-detail"><div><span>温度：</span>${esc(t??"未填写")}${t!=null?"℃":""}</div><div><span>时长：</span>${esc(seconds)}秒</div><div><span>水流：</span>${flow!=null?esc(flow)+" ml/s":"未填写"}</div><div><span>方式：</span>${esc(zhPourPattern(pattern))}</div></div></div>`}).join("")||'<div class="muted">暂无注水数据</div>';
 const pourGrid=$("#pourCards");pourGrid.style.gridTemplateColumns=pours.length?`repeat(${pours.length},minmax(140px,1fr))`:"1fr";
}
function zhPourPattern(v){const m={spiral:"螺旋",center:"中心",circular:"环形",pulse:"脉冲",continuous:"连续"};return m[String(v||"").toLowerCase()]||v||"未填写";}
const adjustAdvice={
 "too_sour":{title:"太酸",judge:"可能萃取不足。",actions:["研磨略细","水温提高约 1℃","适当延长接触时间"],goal:"提高萃取率"},
 "too_bitter":{title:"太苦",judge:"可能萃取过高或尾段过萃。",actions:["研磨略粗","水温降低约 1℃","减弱后段注水"],goal:"降低过度萃取"},
 "too_weak":{title:"太淡",judge:"浓度或萃取率偏低。",actions:["研磨略细","适当减少总水量","加强中段萃取"],goal:"增强浓度与完整度"},
 "too_astringent":{title:"太涩",judge:"常见于尾段过萃或局部萃取不均。",actions:["减少尾段注水","适度降低水温","检查水流是否过慢"],goal:"减少尾段过萃"},
 "too_dull":{title:"太闷",judge:"风味展开不足或萃取层次不清。",actions:["适度降低萃取强度","减少后段堆叠","优先改善干净度"],goal:"提高通透度"},
 "low_sweetness":{title:"甜感不足",judge:"甜感区间可能没有被充分提取。",actions:["优先微调研磨度","水温上下调整约 1℃","保持其它变量不变"],goal:"寻找甜感峰值"},
 "unclear_flavor":{title:"风味不清晰",judge:"萃取可能偏混浊或后段干扰较强。",actions:["减少后段注水","控制总萃取时间","保持前中段稳定"],goal:"提高风味清晰度"},
 "short_finish":{title:"余韵太短",judge:"整体萃取完整度可能不足。",actions:["略微提高萃取率","加强中段有效萃取","避免只依赖尾段补萃"],goal:"提高余韵完整度"}
};
const adjustAdviceRuleMap={sharp:"too_sour",thin:"short_finish",bitter:"too_bitter",ferment:"too_dull",weak:"too_weak",heavy:"too_astringent",sweet:"low_sweetness",aroma:"unclear_flavor"};
function renderAdjustAdvice(rule){
 const key=rule?.id?adjustAdviceRuleMap[rule.id]:null;
 const a=adjustAdvice[key];
 if(!a){$("#adjustAdviceBox").innerHTML='<b>调整建议</b><div class="muted" style="margin-top:8px">请选择一个冲煮问题。</div>';return;}
 $("#adjustAdviceBox").innerHTML=`<b>${esc(a.title)}：${esc(a.goal)}</b><div style="margin-top:8px">判断：${esc(a.judge)}</div><div class="adjust-advice-list">${a.actions.map(x=>`<div>${esc(x)}</div>`).join("")}</div><div class="muted" style="margin-top:8px">原则：一次最多调整 1–2 个变量。</div>`;
}

function editValue(id,v){$(id).value=(v===null||v===undefined)?"":v}
function openEditBeanDialog(){
 if(!selectedBean)return;
 editValue("#editName",selectedBean.name);editValue("#editRoaster",selectedBean.roaster);editValue("#editBeanType",selectedBean.bean_type);
 editValue("#editOrigin",selectedBean.origin);editValue("#editVariety",selectedBean.variety);editValue("#editProcess",selectedBean.process);
 editValue("#editRoastLevel",selectedBean.roast_level);editValue("#editDripper",selectedBean.dripper||"omni2");editValue("#editBrewMethod",selectedBean.brew_method);
 editValue("#editFlavorNotes",(selectedBean.flavor_notes||[]).join(" / "));editValue("#editWeight",selectedBean.weight_g);
 editValue("#editRoastDate",selectedBean.roast_date);editValue("#editIntroduction",selectedBean.introduction);
 editValue("#editFlavorDescription",selectedBean.flavor_description);editValue("#editBrewGuidance",selectedBean.brew_guidance);
 editValue("#editSourceUrl",selectedBean.source_url);editValue("#editNotes",selectedBean.notes);
 $("#editBeanDialog").showModal();
}

async function saveBeanEdits(e){
 e.preventDefault();if(!selected)return;
 const payload={
  name:$("#editName").value.trim(),roaster:$("#editRoaster").value.trim(),bean_type:$("#editBeanType").value,
  origin:$("#editOrigin").value.trim()||null,variety:$("#editVariety").value.trim()||null,process:$("#editProcess").value,
  roast_level:$("#editRoastLevel").value,dripper:$("#editDripper").value||"omni2",brew_method:$("#editBrewMethod").value.trim(),
  flavor_notes:$("#editFlavorNotes").value.split("/").map(x=>x.trim()).filter(Boolean),
  weight_g:$("#editWeight").value?Number($("#editWeight").value):null,roast_date:$("#editRoastDate").value||null,
  introduction:$("#editIntroduction").value.trim(),flavor_description:$("#editFlavorDescription").value.trim(),
  brew_guidance:$("#editBrewGuidance").value.trim(),source_url:$("#editSourceUrl").value.trim()||null,notes:$("#editNotes").value.trim()
 };
 if(!payload.name)return alert("豆名不能为空");
 try{
  await api(`/api/beans/${encodeURIComponent(selected.bean_id)}`,{method:"PATCH",headers:{"Content-Type":"application/json"},body:JSON.stringify(payload)});
  $("#editBeanDialog").close();await loadBeans();await openBean(selected.bean_id);showDetailPane("info");alert("咖啡豆信息已更新。配方版本和当前版本未改变。");
 }catch(e){alert("保存失败："+e.message)}
}

async function openDeleteBeanDialog(beanId=null){
 const id=beanId||(selected&&selected.bean_id);if(!id)return;
 try{
  const p=await api(`/api/beans/${encodeURIComponent(id)}/delete-preview`);
  $("#deleteBeanDialog").dataset.beanId=id;$("#deleteBeanDialog").dataset.beanName=p.name||"";
  $("#deleteConfirmName").value="";$("#deleteReason").value="手工删除";
  const cloud=p.cloud?.synced?"当前版本已同步云端":"当前版本未同步云端";
  $("#deletePreviewBox").innerHTML=`<b>${esc(p.sample_no||"")} · ${esc(p.name||"")}</b><div class="row"><span>当前版本</span><span>${esc(p.current_version||"无")}</span></div><div class="row"><span>原生配方</span><span>${esc(p.native_count)}</span></div><div class="row"><span>候选配方</span><span>${esc(p.candidate_count)}</span></div><div class="row"><span>冲煮反馈</span><span>${esc(p.tasting_count)}</span></div><div class="row"><span>云端</span><span>${esc(cloud)}</span></div><div class="muted" style="margin-top:8px">${esc(p.warning)}</div>`;
  $("#deleteBeanDialog").showModal();
 }catch(e){alert("读取删除信息失败："+e.message)}
}

async function confirmDeleteBean(){
 const dlg=$("#deleteBeanDialog"),beanId=dlg.dataset.beanId,expected=dlg.dataset.beanName,typed=$("#deleteConfirmName").value.trim();
 if(typed!==expected)return alert("请输入完整豆名确认删除。");
 if(!confirm(`确认从本地豆仓删除「${expected}」？\n\n系统会先备份到回收区，但不会删除 xBloom 云端配方。`))return;
 try{
  const r=await api(`/api/beans/${encodeURIComponent(beanId)}/delete`,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({confirm_name:typed,reason:$("#deleteReason").value.trim()||"手工删除"})});
  dlg.close();selected=null;selectedBean=null;currentRecipe=null;currentVersion=null;await loadBeans();showWarehouseView();alert(`已从本地豆仓删除。\n删除前备份：${r.trash_backup}`);
 }catch(e){alert("删除失败："+e.message)}
}

function duplicateBeanHTML(x,label){
 const b=x.bean||{},s=x.summary||{};
 return `<div class="duplicate-bean"><h4>${esc(label)}：${esc(b.sample_no||x.sample_no||"")} · ${esc(b.name||x.name||"")}</h4><div class="muted">${esc(b.roaster||x.roaster||"未填写")}</div><div class="muted">产地：${esc(b.origin||"未填写")} · 品种：${esc(b.variety||"未填写")} · 处理：${esc(b.process||"未填写")}</div><div class="muted">当前版本：${esc(s.current_version||"无")} · 原生 ${esc(s.native_count||0)} · 候选 ${esc(s.candidate_count||0)} · 反馈 ${esc(s.tasting_count||0)}</div><div class="actions section-gap"><button class="action secondary duplicateOpenBtn" data-bean="${esc(x.bean_id)}">查看</button><button class="action secondary duplicateArchiveBtn" data-bean="${esc(x.bean_id)}">归档</button><button class="action danger duplicateDeleteBtn" data-bean="${esc(x.bean_id)}">删除</button></div></div>`;
}

async function loadDuplicateGovernance(){
 try{
  const r=await api("/api/beans/duplicates?threshold=0.62");
  $("#duplicateSummary").textContent=r.pair_count?`发现 ${r.pair_count} 组疑似重复。请人工核对。`:`当前没有达到阈值的疑似重复豆。`;
  $("#duplicatePairs").innerHTML=(r.pairs||[]).map((p,i)=>`<div class="duplicate-pair"><div style="display:flex;justify-content:space-between;gap:10px;align-items:center"><b>疑似重复 #${i+1}</b><span class="duplicate-score">${Math.round(Number(p.score||0)*100)}%</span></div><div class="duplicate-reasons">${(p.reasons||[]).map(x=>`<span class="duplicate-reason">${esc(x)}</span>`).join("")}</div><div class="duplicate-columns">${duplicateBeanHTML(p.a,"A")}${duplicateBeanHTML(p.b,"B")}</div></div>`).join("");
  document.querySelectorAll(".duplicateOpenBtn").forEach(b=>b.onclick=()=>{$("#duplicateGovernanceDialog").close();openBean(b.dataset.bean)});
  document.querySelectorAll(".duplicateArchiveBtn").forEach(b=>b.onclick=async()=>{try{await api(`/api/beans/${encodeURIComponent(b.dataset.bean)}`,{method:"PATCH",headers:{"Content-Type":"application/json"},body:JSON.stringify({status:"archived"})});await loadBeans();await loadDuplicateGovernance()}catch(e){alert("归档失败："+e.message)}});
  document.querySelectorAll(".duplicateDeleteBtn").forEach(b=>b.onclick=()=>openDeleteBeanDialog(b.dataset.bean));
 }catch(e){$("#duplicateSummary").textContent="扫描失败："+e.message;$("#duplicatePairs").innerHTML=""}
}

async function openDuplicateGovernance(){
 $("#duplicateGovernanceDialog").showModal();await loadDuplicateGovernance();
}

async function openBean(id){
 const d=await api("/api/beans/"+encodeURIComponent(id));
 selected=d.meta;selectedBean=d.bean;currentRecipe=d.current_recipe;currentVersion=d.current_version;currentReadiness=d.readiness;activeRule=null;nextRecipe=null;
 $("#newBeanView").classList.add("hidden");$("#settingsView").classList.add("hidden");$("#warehouseView").classList.add("hidden");$("#syncView").classList.add("hidden");$("#detailView").classList.remove("hidden");setBottomNavActive("navWarehouseBtn");showDetailPane("info");
 $("#beanName").textContent=`${d.bean.sample_no} · ${d.bean.name}`;
 $("#beanMeta").textContent=[d.bean.roaster,d.bean.bean_type,labelRoast(d.bean.roast_level),d.bean.weight_g?d.bean.weight_g+"g":""].filter(Boolean).join(" · ");
 $("#flavors").innerHTML=(d.bean.flavor_notes||[]).map(x=>`<span class="tag">${esc(x)}</span>`).join("");
 $("#intro").textContent=d.bean.introduction||"暂无介绍";$("#flavorDesc").textContent=d.bean.flavor_description||"暂无风味描述";$("#brewGuide").textContent=d.bean.brew_guidance||"暂无冲煮方向";
 $("#beanRoast").textContent=labelRoast(d.bean.roast_level)||"—";$("#beanDripper").textContent=zhDripper(d.bean.dripper||"omni2");$("#beanType").textContent=zhBeanType(d.bean.bean_type);$("#beanOrigin").textContent=d.bean.origin||"—";$("#beanVariety").textContent=d.bean.variety||"—";$("#beanProcess").textContent=d.bean.process||"—";$("#beanRoaster").textContent=d.bean.roaster||"—";
 $("#imageArea").innerHTML=d.bean.image_url?`<img class="heroimg" src="${esc(absURL(d.bean.image_url))}" alt="${esc(d.bean.name)}包装">`:`<div class="img-placeholder">暂无图片</div>`;
 $("#readyBadge").innerHTML=stateBadge(currentReadiness);
 renderCloudWorkflow(d.summary?.cloud);
 const latestCandidate=d.latest_candidate||null;
 selectedRecipeContext=currentRecipe?(d.current_recipe_context||{}):(latestCandidate?.context||{});
 const extractionRecipe=currentRecipe||(latestCandidate?.recipe||null);
 renderExtractionCards(extractionRecipe,currentRecipe?"current":(latestCandidate?"candidate":"none"),latestCandidate?.version||null,currentRecipe?d.current_recipe_context:(latestCandidate?.context||null));
 $("#adjustCurrentVersion").textContent=currentVersion?`当前版本 v${currentVersion}`:"尚无当前版本";
 $("#adjustCurrentDripper").textContent=`滤杯 ${zhDripper(selectedRecipeContext?.dripper||selectedBean?.dripper||"omni2")}`;
 if(currentRecipe){
   const total=(currentRecipe.pours||[]).reduce((s,p)=>s+Number(p.ml||0),0);
   $("#metrics").innerHTML=`<div class="metric"><span class="muted">当前版本</span><br><b>v${esc(currentVersion)}</b></div><div class="metric"><span class="muted">粉量</span><br><b>${esc(currentRecipe.dose_g)}g</b></div><div class="metric"><span class="muted">研磨度</span><br><b>${esc(currentRecipe.grind)}</b></div><div class="metric"><span class="muted">实际水量</span><br><b>${esc(total)}ml</b></div>`;
   $("#currentRows").innerHTML=rowsHTML(recipeRows(currentRecipe));$("#compareCurrent").innerHTML=rowsHTML(recipeRows(currentRecipe));
   $("#validationBox").innerHTML=validationHTML(currentReadiness);
 }else{
   $("#metrics").innerHTML="";$("#currentRows").innerHTML=latestCandidate?rowsHTML(recipeRows(latestCandidate.recipe)):'<div class="muted">尚无原生配方</div>';$("#compareCurrent").innerHTML="";$("#validationBox").innerHTML=latestCandidate?validationHTML(latestCandidate.readiness):'<div class="muted">尚无配方</div>';$("#readyBadge").innerHTML=latestCandidate?stateBadge(latestCandidate.readiness):stateBadge(null);
 }
 $("#nextRows").innerHTML="";$("#nextTitle").textContent="等待冲煮反馈";$("#reason").textContent="保存反馈并生成调整方案后，这里显示候选变化。";$("#history").innerHTML="";$("#yamlArea").classList.add("hidden");$("#rawArea").classList.add("hidden");$("#qrArea").classList.add("hidden");
 renderSymptoms();await showHistory();await loadLatestTastingAdjustment();await loadTastingHistoryComparison();
}

function legacyMakeNextCallPath(activeRule){const nextRecipe=makeNext(activeRule);return nextRecipe;}

function renderSymptoms(){
 // v2.3.0: legacy 8-rule engine remains for regression/smoke compatibility,
 // but user input moved to the multi-select inside the tasting dialog.
 $("#symptoms").innerHTML="";
}

function selectedSymptomKeys(){
 return Array.from(document.querySelectorAll('#tasteSymptomMenu input[type="checkbox"]:checked')).map(x=>x.value);
}
const tastingSymptomOptions=[
 ["too_sour","酸太尖 / 发涩"],
 ["short_finish","酸 + 薄 + 不甜"],
 ["too_bitter","苦 / 涩 / 发干"],
 ["too_dull","发酵味太重"],
 ["too_weak","太淡 / 水感重"],
 ["too_astringent","太浓 / 闷"],
 ["low_sweetness","芒果甜感不足"],
 ["unclear_flavor","香气 / 甜橙不足"]
];
function renderTastingSymptomSelector(){
 const menu=$("#tasteSymptomMenu");
 menu.innerHTML=tastingSymptomOptions.map(([k,n])=>`<label><input type="checkbox" value="${k}"><span>${n}</span></label>`).join("");
 menu.querySelectorAll('input[type="checkbox"]').forEach(ch=>ch.onchange=()=>{
   let keys=selectedSymptomKeys();
   if(keys.length>3){ch.checked=false;alert("最多选择 3 个冲煮问题");keys=selectedSymptomKeys();}
   const labels=keys.map(k=>tastingSymptomOptions.find(x=>x[0]===k)?.[1]||k);
   $("#tasteSymptom").value=labels.join("、");
   $("#tasteSymptomToggleText").textContent=labels.length?`已选择 ${labels.length} 项`:`请选择冲煮问题（可多选）`;
   $("#tasteSymptomTags").innerHTML=labels.map((n,i)=>`<span class="multi-tag">${esc(n)} <button type="button" class="tag-remove" data-key="${esc(keys[i])}" style="border:0;background:transparent;cursor:pointer">×</button></span>`).join("");
   document.querySelectorAll(".tag-remove").forEach(b=>b.onclick=()=>{const c=menu.querySelector(`input[value="${b.dataset.key}"]`);if(c){c.checked=false;c.onchange();}});
 });
}
function resetTastingForm(){
 document.querySelectorAll('#tasteSymptomMenu input[type="checkbox"]').forEach(x=>x.checked=false);
 $("#tasteSymptom").value="";$("#tasteSymptomTags").innerHTML="";$("#tasteSymptomToggleText").textContent="请选择冲煮问题（可多选）";$("#tasteNotes").value="";
}
function renderLatestRecommendation(rec,record,linkedCandidateVersion){
 const box=$("#adjustAdviceBox");
 if(!record){box.innerHTML='<b>调整建议</b><div class="muted" style="margin-top:8px">记录冲煮反馈后，这里会自动显示综合建议。</div>';return;}
 if(!rec){box.innerHTML='<b>调整建议</b><div class="muted" style="margin-top:8px">当前反馈暂时无法形成调整建议。</div>';return;}
 const reasons=rec.reasons||[];
 const changes=rec.changes||[];
 const status=rec.actionable?"可形成调整方案":"建议先保持当前配方";
 box.innerHTML=`<b>${esc(status)}</b><div style="margin-top:8px">${esc(rec.reason||"")}</div>${reasons.length?`<div class="adjust-advice-list">${reasons.map(x=>`<div>${esc(x)}</div>`).join("")}</div>`:""}${linkedCandidateVersion?`<div class="muted" style="margin-top:8px">已关联候选 v${esc(linkedCandidateVersion)}</div>`:""}<div class="muted" style="margin-top:8px">原则：一次最多调整 1–2 个变量。</div>`;
 if(changes.length){
   $("#nextTitle").textContent=linkedCandidateVersion?`候选 v${linkedCandidateVersion} · 调整结果`:"调整方案预览";
   $("#nextRows").innerHTML=changes.map(c=>`<div class="row"><span>${esc(c.field)}</span><span class="new">${esc(c.from)} → ${esc(c.to)}</span></div>`).join("");
   $("#reason").textContent=(reasons||[]).join("；")||rec.reason||"已生成调整建议。";
 }else{
   $("#nextTitle").textContent="本轮不自动生成候选";$("#nextRows").innerHTML="";$("#reason").textContent=rec.reason||"当前反馈没有足够明确的单一调整方向。";
 }
}
async function loadLatestTastingAdjustment(){
 if(!selected)return;
 try{
   const x=await api(`/api/beans/${encodeURIComponent(selected.bean_id)}/tasting/latest`);
   const r=x.record;const box=$("#latestTastingBox");
   if(!r){box.innerHTML='<div class="muted">还没有冲煮反馈。点击“记录冲煮反馈”开始。</div>';renderLatestRecommendation(null,null,null);return;}
   const labels=x.symptom_labels?.length?x.symptom_labels:((r.symptom||"")?[r.symptom]:[]);
   const obs=r.ai_observability||{};
   const debug=(obs.event==="fallback"||obs.event==="pre_ai_block")?`<div class="muted" style="margin-top:8px">调试：${esc(r.auto_engine||obs.engine||"")} · ${esc(obs.reason_code||"")}${obs.reason?` · ${esc(obs.reason)}`:""}</div>`:"";
   box.innerHTML=`<b>最近一次冲煮反馈 · v${esc(r.recipe_version||"—")}</b><div class="muted" style="margin-top:5px">滤杯：${esc(zhDripper(r.dripper||selectedBean?.dripper||"omni2"))}</div><div class="latest-tasting-tags">${labels.map(n=>`<span class="latest-tasting-tag">${esc(n)}</span>`).join("")||'<span class="muted">未选择问题</span>'}</div>${(r.notes||[]).length?`<div class="muted" style="margin-top:8px">${esc((r.notes||[]).join("；"))}</div>`:""}${debug}`;
   renderLatestRecommendation(x.recommendation,r,x.linked_candidate_version);
 }catch(e){$("#latestTastingBox").innerHTML=`<div class="muted">读取最近反馈失败：${esc(e.message)}</div>`;}
}


let tastingHistoryRecords=[];
function tastingRecordLabel(r){
 const d=r.date?fmtTimelineTime(r.date):"未知时间";
 return `${d} · v${r.recipe_version||"—"} · ${zhDripper(r.dripper||"omni2")} · ${(r.symptom_labels||[]).join(" + ")||"未选择问题"}`;
}
function renderTastingHistoryList(){
 const box=$("#tastingHistoryList");
 box.innerHTML=tastingHistoryRecords.map(r=>{
   const cmp=r.comparison_to_previous||{};
   const changeText=(r.changes||[]).map(c=>`${esc(c.field)} ${esc(c.from)} → ${esc(c.to)}`).join("；");
   const delta=[];
   if((cmp.resolved_symptoms||[]).length)delta.push(`改善：${cmp.resolved_symptoms.map(esc).join("、")}`);
   if((cmp.added_symptoms||[]).length)delta.push(`新增：${cmp.added_symptoms.map(esc).join("、")}`);
   return `<div class="tasting-history-item"><div class="tasting-history-head"><div><b>${esc(fmtTimelineTime(r.date))} · v${esc(r.recipe_version||"—")}</b><div class="muted" style="margin-top:4px">${esc(zhDripper(r.dripper||"omni2"))}</div><div class="latest-tasting-tags">${(r.symptom_labels||[]).map(n=>`<span class="latest-tasting-tag">${esc(n)}</span>`).join("")||'<span class="muted">未选择问题</span>'}</div></div>${r.candidate_version?`<span class="status ok">候选 v${esc(r.candidate_version)}</span>`:""}</div>${(r.notes||[]).length?`<div class="muted" style="margin-top:8px">${esc((r.notes||[]).join("；"))}</div>`:""}${changeText?`<div style="margin-top:8px">调整：${changeText}</div>`:""}${delta.length?`<div class="muted" style="margin-top:8px">与上次：${delta.join("；")}</div>`:""}</div>`;
 }).join("")||'<div class="muted">暂无冲煮历史。</div>';
}
function updateTastingPickCards(){
 const A=tastingHistoryRecords.find(x=>x.file===$("#tastingCompareA").value);const B=tastingHistoryRecords.find(x=>x.file===$("#tastingCompareB").value);
 $("#tastingCompareACard").innerHTML=A?`<b>较早记录</b><div style="margin-top:5px">${esc(fmtTimelineTime(A.date))} · v${esc(A.recipe_version||"—")}</div><div class="muted">${esc(zhDripper(A.dripper||"omni2"))}</div><div class="muted">${esc((A.symptom_labels||[]).join(" / ")||"未选择问题")}</div>`:'<b>较早记录</b><div class="muted">点击选择</div>';
 $("#tastingCompareBCard").innerHTML=B?`<b>较新记录</b><div style="margin-top:5px">${esc(fmtTimelineTime(B.date))} · v${esc(B.recipe_version||"—")}</div><div class="muted">${esc(zhDripper(B.dripper||"omni2"))}</div><div class="muted">${esc((B.symptom_labels||[]).join(" / ")||"未选择问题")}</div>`:'<b>较新记录</b><div class="muted">点击选择</div>';
}
function renderTastingComparison(){
 const a=$("#tastingCompareA").value,b=$("#tastingCompareB").value,box=$("#tastingCompareBox");updateTastingPickCards();
 if(!a||!b||a===b){box.innerHTML='<div class="muted">请选择两条不同的冲煮记录。</div>';return;}
 const A=tastingHistoryRecords.find(x=>x.file===a),B=tastingHistoryRecords.find(x=>x.file===b);if(!A||!B)return;
 const sa=new Set(A.symptom_labels||[]),sb=new Set(B.symptom_labels||[]);
 const resolved=[...sa].filter(x=>!sb.has(x)),added=[...sb].filter(x=>!sa.has(x)),same=[...sb].filter(x=>sa.has(x));
 const changes=(B.changes||[]).map(c=>`${esc(c.field)} ${esc(c.from)} → ${esc(c.to)}`).join("；")||"本次未生成自动调整";
 const dripperChange=(A.dripper||"omni2")!==(B.dripper||"omni2")?`${esc(zhDripper(A.dripper||"omni2"))} → ${esc(zhDripper(B.dripper||"omni2"))}`:"未变化";
 box.innerHTML=`<div class="compact-summary"><div class="compact-summary-head"><b>对比结果</b><span class="status">滤杯：${dripperChange}</span></div><div class="compact-summary-grid"><div><b>改善</b><div class="muted">${resolved.map(esc).join("、")||"无"}</div></div><div><b>新增</b><div class="muted">${added.map(esc).join("、")||"无"}</div></div><div><b>持续</b><div class="muted">${same.map(esc).join("、")||"无"}</div></div><div><b>B 次调整</b><div class="muted">${changes}</div></div></div></div>`;
}
function openTastingChooser(which){
 const menu=$("#tastingRecordChooser");menu.classList.remove("hidden");
 menu.innerHTML=tastingHistoryRecords.map(r=>`<button class="history-record-option" data-file="${esc(r.file)}"><b>${esc(fmtTimelineTime(r.date))} · v${esc(r.recipe_version||"—")}</b><div class="muted">${esc(zhDripper(r.dripper||"omni2"))} · ${esc((r.symptom_labels||[]).join(" / ")||"未选择问题")}</div></button>`).join("")||'<div class="muted">暂无记录</div>';
 menu.querySelectorAll("[data-file]").forEach(btn=>btn.onclick=()=>{$(`#tastingCompare${which}`).value=btn.dataset.file;menu.classList.add("hidden");renderTastingComparison();});
}
async function loadTastingHistoryComparison(){
 if(!selected)return;
 try{
   const x=await api(`/api/beans/${encodeURIComponent(selected.bean_id)}/tasting/history`);tastingHistoryRecords=x.records||[];renderTastingHistoryList();
   $("#tastingHistoryCount").textContent=`${tastingHistoryRecords.length} 次`;
   if(tastingHistoryRecords.length>=2){$("#tastingCompareA").value=tastingHistoryRecords[1].file;$("#tastingCompareB").value=tastingHistoryRecords[0].file;renderTastingComparison();}
   else{$("#tastingCompareA").value="";$("#tastingCompareB").value="";updateTastingPickCards();$("#tastingCompareBox").innerHTML='<div class="muted">有两条以上冲煮记录后可进行对比。</div>';}
 }catch(e){$("#tastingHistoryList").innerHTML=`<div class="muted">读取冲煮历史失败：${esc(e.message)}</div>`;}
}
$("#tastingCompareACard").onclick=()=>openTastingChooser("A");$("#tastingCompareBCard").onclick=()=>openTastingChooser("B");$("#refreshTastingHistoryBtn").onclick=loadTastingHistoryComparison;

