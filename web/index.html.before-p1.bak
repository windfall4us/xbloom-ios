let beanCreateMode="save_only";
function setIntakeStep(step){
 const ids=["stepPhoto","stepProfile","stepSave","stepCandidate"];
 ids.forEach((id,i)=>{const el=$("#"+id);el.classList.remove("active","done");if(i<step)el.classList.add("done");else if(i===step)el.classList.add("active")});
}
function showIntakePanel(step){
 setIntakeStep(step);
 $("#intakePhotoPanel").classList.toggle("hidden",step!==0);
 $("#intakeProfilePanel").classList.toggle("hidden",step!==1);
 if(step===1)setTimeout(()=>document.querySelector('#newBeanForm [name="name"]')?.focus(),50);
}
function resetIntakeUI(){
 beanCreateMode="save_only";showIntakePanel(0);$("#intakeSummary").classList.add("hidden");$("#intakeSummary").innerHTML="";$("#recognitionStatus").classList.add("hidden");$("#beanPhotoPreview").style.display="none";$("#recognizePhotoBtn").classList.add("hidden");
}

function setFormValue(form,name,value){
 const el=form.elements[name];
 if(!el||value===undefined||value===null||value==="")return;
 if(name==="flavor_notes"&&Array.isArray(value))value=value.join(" / ");
 el.value=String(value);
}
function fillBeanRecognition(fields){
 const form=$("#newBeanForm");
 const keys=["name","roaster","bean_type","origin","variety","process","roast_level","flavor_notes","introduction","flavor_description","brew_guidance","brew_method","weight_g","notes"];
 keys.forEach(k=>setFormValue(form,k,fields?.[k]));
}
async function recognizeBeanPhoto(){
 const input=$("#beanPhotoInput");
 const file=input.files&&input.files[0];
 if(!file)return alert("请先拍照或选择咖啡包装图片。");
 const status=$("#recognitionStatus");
 status.classList.remove("hidden");
 status.innerHTML="正在识别包装…";
 const fd=new FormData();fd.append("image",file);
 try{
   const r=await api("/api/beans/recognize-label",{method:"POST",body:fd});
   fillBeanRecognition(r.fields||{}); showIntakePanel(1);
   const found=Object.entries(r.fields||{}).filter(([k,v])=>v!==""&&v!==null&&(!(Array.isArray(v))||v.length)).map(([k])=>k);
   status.innerHTML=`识别完成 · ${esc(r.engine||"unknown")} · 已填 ${found.length} 个字段。<br><b>请人工确认后再保存。</b>${r.engine==="local_ocr"?"<br>复杂字体/标志图形可能识别不完整；未识别字段保持为空。":"<br>本次优先使用人工智能识别。"}${r.ai_fallback_reason?`<br><span style="color:var(--warn)">人工智能识别失败，已回退本地文字识别：${esc(r.ai_fallback_reason)}</span>`:""}`;
   const f=r.fields||{};$("#intakeSummary").classList.remove("hidden");$("#intakeSummary").innerHTML=`<b>识别摘要</b><br>豆名：${esc(f.name||"—")}<br>烘焙商：${esc(f.roaster||"—")}<br>产区：${esc(f.origin||"—")}<br>品种：${esc(f.variety||"—")}<br>处理法：${esc(f.process||"—")}<br>风味：${esc((f.flavor_notes||[]).join(" / ")||"—")}`;
 }catch(e){
   status.innerHTML=`<span style="color:var(--bad)">识别失败：${esc(e.message)}</span>`;
 }
}
$("#beanPhotoInput").onchange=()=>{
 const file=$("#beanPhotoInput").files&&$("#beanPhotoInput").files[0];
 if(!file)return;
 $("#beanPhotoPreview").src=URL.createObjectURL(file);
 $("#beanPhotoPreview").style.display="block";$("#recognizePhotoBtn").classList.remove("hidden");
 recognizeBeanPhoto();
};
$("#recognizePhotoBtn").onclick=recognizeBeanPhoto;
$("#skipPhotoBtn").onclick=()=>showIntakePanel(1);
$("#stepPhoto").onclick=()=>showIntakePanel(0);
$("#stepProfile").onclick=()=>showIntakePanel(1);


$("#newBeanBackBtn").onclick=showWarehouseView;

function updateNewBeanRestingPreview(){
 const f=$("#newBeanForm"),date=f.elements["roast_date"]?.value,roast=f.elements["roast_level"]?.value;
 const days={light:14,medium_light:12,medium:10,medium_dark:7,dark:5}[roast]??10;
 if(!date){$("#newBeanRestingPreview").textContent="填写烘焙日期与烘焙度后，将预估养豆状态。";return}
 const d=new Date(date+"T00:00:00");d.setDate(d.getDate()+days);$("#newBeanRestingPreview").textContent=`按当前显示规则：预计养豆至 ${d.toLocaleDateString()}；到期后自动进入「在喝」。`;
}
$("#newBeanForm").elements["roast_date"].onchange=updateNewBeanRestingPreview;
$("#newBeanForm").elements["roast_level"].onchange=updateNewBeanRestingPreview;

async function createBeanFromForm(generateAfter=false){
 const form=$("#newBeanForm");if(!form.reportValidity())return;
 const fd=new FormData(form),image=fd.get("image"),obj={};
 for(const [k,v] of fd.entries())if(k!=="image")obj[k]=v;
 obj.flavor_notes=(obj.flavor_notes||"").split("/").map(x=>x.trim()).filter(Boolean);
 obj.weight_g=obj.weight_g?Number(obj.weight_g):null;
 for(const k of ["roast_date","source_url","origin","variety"])if(!obj[k])obj[k]=null;
 try{
   setIntakeStep(2);
   const created=await api("/api/beans",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(obj)});
   if(image&&image.size){const im=new FormData();im.append("image",image);await api(`/api/beans/${encodeURIComponent(created.bean.bean_id)}/image`,{method:"POST",body:im})}
   let candidate=null;
   if(generateAfter){
     setIntakeStep(3);
     candidate=await api(`/api/beans/${encodeURIComponent(created.bean.bean_id)}/generate-initial-ai`,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({style:"balanced",focus:obj.flavor_notes||[],dripper:obj.dripper||"omni2",use_ai:true})});
   }
   $("#newBeanView").classList.add("hidden");form.reset();await loadBeans();await openBean(created.bean.bean_id);showDetailPane("extraction");
   if(candidate){const fallback=candidate.ai_fallback_reason?`
AI 回退原因：${candidate.ai_fallback_reason}`:"";alert(`咖啡豆已保存。
首版候选配方 v${candidate.version} 已生成。
引擎：${candidate.engine}
状态：${candidate.readiness?.state||"—"}${fallback}

候选配方已显示在「萃取」页，但不会自动成为当前版本。`);await showHistory()}
   else alert("咖啡豆信息已保存。可在「萃取」页点击“生成首版萃取配方”。");
 }catch(e){showIntakePanel(1);alert("新增失败："+e.message)}
}
$("#newBeanForm").onsubmit=async e=>{e.preventDefault();await createBeanFromForm(false)};
$("#saveAndGenerateBtn").onclick=async()=>{await createBeanFromForm(true)};

$("#detailInfoTab").onclick=()=>showDetailPane("info");
