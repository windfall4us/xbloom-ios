     model: $("#cfgModel").value.trim(),
     for_recognition: $("#cfgRecognition").checked,
     for_brew_advice: $("#cfgBrewAdvice").checked
   };
   const r=await api("/api/settings",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(payload)});
   alert("AI 设置已保存。后续识别与冲煮建议会按当前配置执行。");
 }catch(e){
   alert("保存设置失败："+e.message);
 }
};

