let selectedPromoteVersion=null;

function fmtTimelineTime(v){
 if(!v)return "—";
 try{return new Date(v).toLocaleString("zh-CN",{hour12:false})}catch(e){return v}
}

function renderVersionTimeline(events){
 const box=$("#versionTimeline");
 box.classList.remove("expanded");$("#toggleTimelineBtn").textContent="查看全部";
 box.innerHTML=(events||[]).map(e=>`<div class="timeline-item"><b>${esc(e.title||"版本记录")}</b><div class="timeline-time">${esc(fmtTimelineTime(e.at))}</div>${e.detail?`<div class="timeline-detail">${esc(e.detail)}</div>`:""}</div>`).join("")||'<div class="muted">暂无时间线记录</div>';
}
$("#toggleTimelineBtn").onclick=()=>{const b=$("#versionTimeline");b.classList.toggle("expanded");$("#toggleTimelineBtn").textContent=b.classList.contains("expanded")?"收起":"查看全部";};

function renderPromotionSummary(h){
 const box=$("#promotionCandidateList");
 const nativeVersions=new Set((h.native||[]).map(x=>String(x.version)));
 const rows=(h.candidates||[]).filter(x=>!nativeVersions.has(String(x.version))).map(x=>{
   const can=x.readiness?.internal?.valid && x.readiness?.external?.available && x.readiness?.external?.passed;
   const label=can?"检查并设为当前版本":"查看阻止原因";
   return `<div class="candidate-row"><div><b>候选 v${esc(x.version)}</b><div style="margin-top:5px">${stateBadge(x.readiness)}</div></div><button class="action secondary promote-review" data-v="${esc(x.version)}">${label}</button></div>`;
 }).join("");
 box.innerHTML=rows||'<div class="muted">暂无候选版本。</div>';
 document.querySelectorAll(".promote-review").forEach(btn=>btn.onclick=()=>openPromoteDialog(btn.dataset.v));
}

function promotionChangesHTML(changes){
 return (changes||[]).map(c=>{
   const unit=c.unit||"";const before=c.before==null?"未填写":`${c.before}${unit}`;const after=c.after==null?"未填写":`${c.after}${unit}`;
   return `<div class="promotion-change"><span class="label">${esc(c.label)}</span><span class="before">${esc(before)}</span><span class="arrow">→</span><span class="after">${esc(after)}</span></div>`;
 }).join("")||'<div class="muted">与当前版本没有可见参数差异。</div>';
}

async function openPromoteDialog(version){
 if(!selected)return;
 selectedPromoteVersion=version;
 $("#promoteIntro").textContent=`候选 v${version} → ${currentVersion?`当前 v${currentVersion}`:"尚无当前版本"}`;
 $("#promoteGateBox").innerHTML='<span class="muted">正在检查…</span>';
 $("#promoteChanges").innerHTML="";
 $("#confirmPromoteBtn").disabled=true;
 $("#promoteDialog").showModal();
 try{
   const p=await api(`/api/beans/${encodeURIComponent(selected.bean_id)}/recipes/${encodeURIComponent(version)}/promote-preview`);
   const blockers=p.blockers||[];
   $("#promoteGateBox").innerHTML=`<div><b>晋升门禁</b> ${p.can_promote?'<span class="status ok">可以设为当前版本</span>':'<span class="status bad">暂不可设为当前版本</span>'}</div>${blockers.length?`<div class="muted" style="margin-top:8px">${blockers.map(esc).join("；")}</div>`:'<div class="muted" style="margin-top:8px">内部校验与 xBloom 外部校验均已通过。</div>'}`;
   $("#promoteChanges").innerHTML=promotionChangesHTML(p.changes);
   $("#confirmPromoteBtn").disabled=!p.can_promote;
 }catch(e){
   $("#promoteGateBox").innerHTML=`<span class="status bad">检查失败</span><div class="muted" style="margin-top:8px">${esc(e.message)}</div>`;
 }
}

async function showHistory(){
 if(!selected)return;
 const h=await api(`/api/beans/${encodeURIComponent(selected.bean_id)}/history`);
 let hhtml='<h3>原生版本</h3>';
 hhtml+=(h.native||[]).map(x=>`<div class="row"><span>v${esc(x.version)} ${String(h.current_version)===String(x.version)?'<b style="color:var(--ok)">· 当前</b>':''}</span><span>${stateBadge(x.readiness)}</span></div>`).join("")||'<div class="muted">无</div>';
 hhtml+='<h3 style="margin-top:14px">候选版本</h3>';
 hhtml+=(h.candidates||[]).map(x=>`<div class="row"><span>v${esc(x.version)}</span><span>${stateBadge(x.readiness)}</span></div>`).join("")||'<div class="muted">无</div>';
 $("#history").innerHTML=hhtml;
 renderPromotionSummary(h);
 renderVersionTimeline(h.timeline||[]);
}
$("#historyBtn").onclick=showHistory;
$("#backupBtn").onclick=async()=>{const r=await api("/api/backup",{method:"POST"});alert("备份完成："+r.backup)}

$("#refreshTimelineBtn").onclick=showHistory;
$("#closePromoteBtn").onclick=()=>{$("#promoteDialog").close();selectedPromoteVersion=null};
$("#confirmPromoteBtn").onclick=async()=>{
 if(!selected||!selectedPromoteVersion)return;
 const v=selectedPromoteVersion;
 if(!confirm(`确认将候选 v${v} 固化为新的原生配方，并设为当前版本？\n\n已有原生版本不会被修改。`))return;
 const btn=$("#confirmPromoteBtn");const old=btn.textContent;btn.disabled=true;btn.textContent="处理中…";
 try{
   const r=await api(`/api/beans/${encodeURIComponent(selected.bean_id)}/recipes/${encodeURIComponent(v)}/promote`,{method:"POST"});
   $("#promoteDialog").close();selectedPromoteVersion=null;
   alert(`v${v} 已设为当前版本。\n状态：${r.readiness.state}`);
   await openBean(selected.bean_id);
 }catch(e){alert("设为当前版本失败："+e.message)}finally{btn.disabled=false;btn.textContent=old}
};



