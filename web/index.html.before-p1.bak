$("#cloudSyncBtn").onclick=async()=>{
 if(!selected||!currentVersion)return alert("当前没有原生配方");
 if(!currentReadiness||!currentReadiness.ready){
   return alert("当前配方还不是 xBloom Ready，不能同步到 Cloud。");
 }
 if(!confirm(`将 ${selected.name||selected.bean_id} v${currentVersion} 同步到 xBloom Cloud？\n\n只同步当前 Native Recipe，不会触发机器冲煮。`))return;
 try{
   const r=await api(`/api/beans/${encodeURIComponent(selected.bean_id)}/recipes/${encodeURIComponent(currentVersion)}/cloud-sync`,{method:"POST"});
   renderCloudWorkflow(r.cloud_state);
   await loadBeans();
   alert(`云端同步成功。\n账号：${r.cloud.email||""}\n云端配方：${r.cloud_state?.cloud_name||"—"}\n下一步请在 xBloom App 中分配 A/B/C。`);
 }catch(e){
   alert("Cloud Sync 失败："+e.message);
 }
};

$("#cloudListBtn").onclick=async()=>{
 try{
   const r=await api("/api/cloud/list");
   $("#yamlPre").textContent=r.result.stdout||"(no output)";
   $("#yamlArea").classList.remove("hidden");
 }catch(e){
   alert("读取 云端配方 失败："+e.message);
 }
};




loadBeans();
/* ============ v0.1 iOS shim: server address editor ============ */
(function(){
  var btn=document.getElementById("iosServerBtn"),box=document.getElementById("iosServerBox"),inp=document.getElementById("iosServerInput"),save=document.getElementById("iosServerSave"),close=document.getElementById("iosServerClose");
  if(!btn||!box||!inp||!save||!close)return;
  btn.onclick=function(){inp.value=API_BASE;box.style.display=box.style.display==="none"?"block":"none";};
  close.onclick=function(){box.style.display="none";};
  save.onclick=function(){
    var v=inp.value.trim().replace(/\/+$/,"");
    if(!/^https?:\/\//.test(v)){alert("地址需以 http:// 或 https:// 开头");return;}
    localStorage.setItem("xbloom_api_base",v);
    location.reload();
  };
})();
/* ============ end v0.1 shim ============ */
</script>


