refreshDripperOptions();
function openTastingDialog(){if(selected&&currentVersion){resetTastingForm();const ctx=selectedRecipeContext||{};$("#tasteDripper").value=ctx.dripper||selectedBean?.dripper||"omni2";$("#tastingDialog").showModal();}else alert("当前没有可记录的当前版本配方")};
$("#tastingBtn").onclick=openTastingDialog;
$("#recordTastingTopBtn").onclick=openTastingDialog;
$("#tasteSymptomToggle").onclick=()=>$("#tasteSymptomMenu").classList.toggle("hidden");
$("#closeTastingBtn").onclick=()=>$("#tastingDialog").close();
async function submitTasting(generateCandidate){
 if(!selected||!currentVersion)return;
 const symptoms=selectedSymptomKeys();
 if(generateCandidate && symptoms.length===0)return alert("生成调整方案前请至少选择 1 个冲煮问题");
 const payload={bean_id:selected.bean_id,recipe_version:String(currentVersion),dripper:$("#tasteDripper").value||selectedBean?.dripper||"omni2",symptoms,symptom:$("#tasteSymptom").value.trim(),notes:$("#tasteNotes").value.split("\n").map(x=>x.trim()).filter(Boolean),generate_candidate:!!generateCandidate};
 try{
   const r=await api("/api/tasting/detailed",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(payload)});
   $("#tastingDialog").close();resetTastingForm();
   const a=r.auto_candidate||{};
   if(generateCandidate && a.created){
     const changeText=(a.changes||[]).map(x=>`${x.field}: ${x.from} → ${x.to}`).join("\n");
     const fallback=a.ai_observability?.event==="fallback"?`\n\nAI 建议未通过规则校验，已使用稳定规则。\n原因：${a.ai_observability?.reason_code||"unknown"}`:"";
     alert(`冲煮反馈已保存。\n\n已生成 Candidate v${a.version}\n${changeText}${fallback}\n\n当前版本未改变。`);
   }else if(generateCandidate){
     alert(`冲煮反馈已保存。\n\n本轮没有自动生成 Candidate：\n${a.recommendation?.reason||a.reason||"没有足够明确的调整方向"}\n\n当前版本未改变。`);
   }else alert("冲煮反馈已保存。本次未生成 Candidate。");
   await loadBeans();await showHistory();await loadLatestTastingAdjustment();await loadTastingHistoryComparison();
 }catch(e){alert("保存失败："+e.message)}
}
$("#saveTastingOnlyBtn").onclick=()=>submitTasting(false);
$("#saveTastingBtn").onclick=()=>submitTasting(true);




function showSettingsPane(name){
 const ai=name==="ai";
 const cloud=name==="cloud";
 const status=name==="status";
 const resting=name==="resting";
 const drippers=name==="drippers";
 $("#settingsAiPane").classList.toggle("hidden",!ai);
 $("#settingsCloudPane").classList.toggle("hidden",!cloud);
 $("#settingsStatusPane").classList.toggle("hidden",!status);
 $("#settingsRestingPane").classList.toggle("hidden",!resting);
 $("#settingsDripperPane").classList.toggle("hidden",!drippers);
 $("#settingsAiTab").classList.toggle("active",ai);
 $("#settingsCloudTab").classList.toggle("active",cloud);
 $("#settingsStatusTab").classList.toggle("active",status);
 $("#settingsRestingTab").classList.toggle("active",resting);
 $("#settingsDripperTab").classList.toggle("active",drippers);
 if(cloud)loadCloudSettings();
 if(status)loadSystemStatus();
 if(resting)loadRestingSettings();
 if(drippers)loadDripperRegistry();
}


function renderCloudSettingsState(c){
 const s=c||{};
 $("#cloudCfgStatus").innerHTML=s.configured
   ? '<b style="color:var(--ok)">READY</b>'
   : '<b style="color:var(--warn)">UNCONFIGURED</b>';
 $("#cloudCfgEmail").textContent=s.masked_email||"—";
 $("#cloudCfgSource").textContent=s.source||"none";
 $("#cloudCfgCli").innerHTML=s.cli_available
   ? '<b style="color:var(--ok)">READY</b>'
   : '<b style="color:var(--bad)">MISSING</b>';
 $("#cloudSettingsHint").innerHTML=s.has_password
   ? `服务器已保存 Cloud 密码。密码输入框留空会保留现有密码。`
   : `尚未保存 Cloud 密码。`;
}

async function loadCloudSettings(){
 try{
   const c=await api("/api/cloud/settings");
   $("#cfgCloudEmail").value=c.email||"";
   $("#cfgCloudPassword").value="";
   renderCloudSettingsState(c);
 }catch(e){
   $("#cloudSettingsHint").textContent="读取 Cloud 设置失败："+e.message;
 }
}

async function loadSystemStatus(){
 try{
   const [health,cloud,settings,aiObs]=await Promise.all([
     api("/api/health"),
     api("/api/cloud/status"),
     api("/api/settings"),
     api("/api/ai/recommendation-observability")
   ]);
   $("#statusVersion").textContent=health.version||"—";
   $("#statusWorkflow").textContent=health.workflow||"—";
   const v=health.external_validator||{};
   $("#statusValidator").innerHTML=v.available
     ? `<b style="color:var(--ok)">READY</b> · ${esc(v.version||"")}`
     : `<b style="color:var(--bad)">${esc(v.status||"MISSING")}</b>`;
   $("#statusCloud").innerHTML=cloud.configured
     ? `<b style="color:var(--ok)">READY</b> · ${esc(cloud.email||"")}`
     : `<b style="color:var(--warn)">UNCONFIGURED</b>`;
   const ai=settings.ai||{};
   $("#statusAI").innerHTML=ai.enabled&&ai.has_api_key
     ? `<b style="color:var(--ok)">READY</b> · ${esc(ai.model||"")}`
     : `<b style="color:var(--warn)">${ai.enabled?"MISSING KEY":"DISABLED"}</b>`;
   const totals=aiObs.totals||{};
   $("#statusAiAttempts").textContent=totals.ai_attempts||0;
   $("#statusAiAccepted").textContent=totals.ai_accepted||0;
   $("#statusAiFallbacks").textContent=totals.fallbacks||0;
   $("#statusAiBlocks").textContent=totals.pre_ai_blocks||0;
   const last=aiObs.last_event||{};
   $("#statusAiLastReject").textContent=(last.reason_code||last.reason)?`${last.reason_code||""}${last.reason?" · "+last.reason:""}`:"暂无";
 }catch(e){
   $("#statusVersion").textContent="ERROR";
   $("#statusWorkflow").textContent=e.message;
 }
}


function restoreBottomNavForVisibleView(){
 if(!$("#syncView").classList.contains("hidden"))setBottomNavActive("navSyncBtn");
 else setBottomNavActive("navWarehouseBtn");
}

async function openSettingsDialog(){
 try{
   const s=await api("/api/settings");
   const ai=s.ai||{};
   $("#cfgBaseUrl").value=ai.base_url||"";
   $("#cfgModel").value=ai.model||"";
   $("#cfgApiKey").value="";
   $("#cfgEnabled").checked=!!ai.enabled;
   $("#cfgRecognition").checked=!!ai.for_recognition;
   $("#cfgBrewAdvice").checked=!!ai.for_brew_advice;
   $("#settingsHint").innerHTML=ai.has_api_key
     ? `当前已保存 API Key：${esc(ai.masked_api_key||"已保存")}<br>如不想修改密钥，请将 API Key 输入框留空。`
     : "尚未保存 API Key。保存后可用于包装识别和冲煮建议。";
   showSettingsPane("ai");
   $("#warehouseView").classList.add("hidden");
   $("#syncView").classList.add("hidden");
   $("#detailView").classList.add("hidden");
   $("#newBeanView").classList.add("hidden");
   $("#settingsView").classList.remove("hidden");
   setBottomNavActive("navSettingsBtn");
   window.scrollTo({top:0,behavior:"smooth"});
 }catch(e){
   alert("读取设置失败："+e.message);
 }
}

$("#navSettingsBtn").onclick=()=>{setBottomNavActive("navSettingsBtn");openSettingsDialog();};
$("#settingsBackBtn").onclick=showWarehouseView;

$("#settingsAiTab").onclick=()=>showSettingsPane("ai");
$("#settingsCloudTab").onclick=()=>showSettingsPane("cloud");
$("#settingsStatusTab").onclick=()=>showSettingsPane("status");
$("#settingsRestingTab").onclick=()=>showSettingsPane("resting");
$("#settingsDripperTab").onclick=()=>showSettingsPane("drippers");

let dripperRegistryCache=[];
function dripperOptionLabel(p){return p.label||[p.brand,p.model].filter(Boolean).join(" ")||p.key}
async function refreshDripperOptions(){
  try{
    const r=await api("/api/drippers");
    const rows=r.profiles||[];
    const targets=[document.querySelector('select[name="dripper"]'),$("#editDripper"),$("#initialDripper"),$("#extractionDripperSelect"),$("#tasteDripper")].filter(Boolean);
    for(const sel of targets){
      const prev=sel.value||"omni2";
      sel.innerHTML=rows.map(p=>`<option value="${esc(p.key)}">${esc(dripperOptionLabel(p))}${p.key==="omni2"?"（默认）":""}</option>`).join("");
      if(rows.some(p=>p.key===prev))sel.value=prev; else if(rows.some(p=>p.key==="omni2"))sel.value="omni2";
    }
  }catch(e){console.warn("load drippers failed",e)}
}
$("#adaptDripperBtn").onclick=async()=>{
 if(!selected||!currentVersion)return alert("当前没有可适配的当前版本");
 const target=$("#extractionDripperSelect").value||"omni2";const current=$("#extractionDripperSelect").dataset.current||selectedRecipeContext?.dripper||selectedBean?.dripper||"omni2";
 if(target===current)return alert("目标滤杯与当前版本一致，无需生成候选。");
 if(!confirm(`当前滤杯：${zhDripper(current)}\n目标滤杯：${zhDripper(target)}\n\n将生成新的滤杯适配 Candidate，当前版本不会改变。`))return;
 try{const r=await api(`/api/beans/${encodeURIComponent(selected.bean_id)}/recipes/${encodeURIComponent(currentVersion)}/adapt-dripper`,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({dripper:target})});if(r.created){alert(`已生成滤杯适配候选 v${r.version}。\n当前版本未改变。`);await openBean(selected.bean_id);showDetailPane("adjust");}else alert(r.reason||"未生成候选");}catch(e){alert("生成滤杯适配候选失败："+e.message)}
};
function clearDripperEditor(){
  $("#dripperEditKey").value="";$("#dripperBrand").value="";$("#dripperModel").value="";$("#dripperShape").value="conical";$("#dripperFlowClass").value="medium";$("#dripperGrindOffset").value="0";$("#dripperTempOffset").value="0";$("#dripperBloomOffset").value="0";$("#dripperFlowOffset").value="0";
}
async function loadDripperRegistry(){
  try{
    const r=await api("/api/settings/drippers");dripperRegistryCache=r.profiles||[];
    $("#dripperRegistryList").innerHTML=dripperRegistryCache.map(p=>`<div class="dripper-registry-item"><div class="dripper-registry-head"><div><b>${esc(dripperOptionLabel(p))}</b><div class="dripper-registry-meta">${p.source==="system"?"系统预置":"自定义"}${p.profile_type==="preset"?" · 专属基准":""} · ${p.shape==="flat"?"平底":p.shape==="conical"?"锥形":"其他"} · ${p.flow_class==="ultra_fast"?"超快流":p.flow_class==="fast"?"快流":p.flow_class==="slow"?"慢流":"中等流速"} · rev ${esc(p.revision||1)} · 引用 ${esc(p.references||0)}</div></div><span class="status ${p.enabled?"ok":"warn"}">${p.enabled?"启用":"停用"}</span></div><div class="actions" style="margin-top:10px"><button class="action secondary" data-dripper-toggle="${esc(p.key)}" data-enabled="${p.enabled?"0":"1"}">${p.enabled?"停用":"启用"}</button>${p.source==="custom"?`<button class="action secondary" data-dripper-edit="${esc(p.key)}">编辑</button><button class="action secondary" data-dripper-delete="${esc(p.key)}" ${Number(p.references||0)>0?"disabled title=\"存在引用，只能停用\"":""}>删除</button>`:""}</div></div>`).join("")||'<div class="muted">暂无滤杯</div>';
    $("#dripperRegistryList").querySelectorAll("[data-dripper-toggle]").forEach(b=>b.onclick=async()=>{await api("/api/settings/drippers",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({action:"toggle",key:b.dataset.dripperToggle,enabled:b.dataset.enabled==="1"})});await loadDripperRegistry();await refreshDripperOptions();});
    $("#dripperRegistryList").querySelectorAll("[data-dripper-edit]").forEach(b=>b.onclick=()=>{const p=dripperRegistryCache.find(x=>x.key===b.dataset.dripperEdit);if(!p)return;$("#dripperEditKey").value=p.key;$("#dripperBrand").value=p.brand||"";$("#dripperModel").value=p.model||"";$("#dripperShape").value=p.shape||"other";$("#dripperFlowClass").value=p.flow_class||"medium";$("#dripperGrindOffset").value=p.grind_offset??0;$("#dripperTempOffset").value=p.temp_offset??0;$("#dripperBloomOffset").value=p.bloom_pause_delta??0;$("#dripperFlowOffset").value=p.flow_delta??0;window.scrollTo({top:0,behavior:"smooth"});});
    $("#dripperRegistryList").querySelectorAll("[data-dripper-delete]").forEach(b=>b.onclick=async()=>{if(!confirm("确认删除这个未被引用的自定义滤杯？"))return;try{await api("/api/settings/drippers",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({action:"delete",key:b.dataset.dripperDelete})});await loadDripperRegistry();await refreshDripperOptions();}catch(e){alert("删除失败："+e.message)}});
  }catch(e){$("#dripperRegistryList").innerHTML=`<div class="muted">读取滤杯设置失败：${esc(e.message)}</div>`}
}
$("#saveDripperBtn").onclick=async()=>{try{const body={action:"save",key:$("#dripperEditKey").value||null,dripper:{brand:$("#dripperBrand").value.trim(),model:$("#dripperModel").value.trim(),shape:$("#dripperShape").value,flow_class:$("#dripperFlowClass").value,grind_offset:Number($("#dripperGrindOffset").value||0),temp_offset:Number($("#dripperTempOffset").value||0),bloom_pause_delta:Number($("#dripperBloomOffset").value||0),flow_delta:Number($("#dripperFlowOffset").value||0)}};await api("/api/settings/drippers",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(body)});clearDripperEditor();await loadDripperRegistry();await refreshDripperOptions();alert("滤杯已保存");}catch(e){alert("保存失败："+e.message)}};
$("#resetDripperEditorBtn").onclick=clearDripperEditor;
$("#closeDripperSettingsBtn").onclick=showWarehouseView;

async function loadRestingSettings(){
  try{
    const r=await api("/api/settings/resting");
    const src=r.source==="custom"?"自定义":"默认";
    $("#restingSource").textContent=src; $("#restingSource").className="status "+(r.source==="custom"?"warn":"ok");
    for(const k of Object.keys(r.resting_days||{})){
      const el=$("#resting_"+k);
      if(el) el.value=r.resting_days[k];
    }
    $("#resting_unknown").value=r.unknown_default||10;
    $("#restingHint").textContent="当前规则："+(r.source==="custom"?"自定义（已保存到服务器）":"系统默认");
    updateRestingRulePreview();
  }catch(e){ $("#restingHint").textContent="读取养豆规则失败："+e.message; }
}
function updateRestingRulePreview(){const v=parseInt($("#resting_light")?.value||14,10);$("#restingRulePreview").textContent=`浅烘：0–${v} 天养豆，第 ${v+1} 天起进入「在喝」。其他烘焙度按上方各自行数计算。`;}
["light","medium_light","medium","medium_dark","dark"].forEach(k=>{const el=$("#resting_"+k);if(el)el.oninput=updateRestingRulePreview;});
function collectRestingDays(){
  const out={};
  for(const k of ["light","medium_light","medium","medium_dark","dark"]){
    const el=$("#resting_"+k);
    const v=el?parseInt(el.value,10):NaN;
    if(!Number.isFinite(v)) throw new Error("请填写完整的整数天数："+k);
    out[k]=v;
  }
  return out;
}
$("#saveRestingBtn").onclick=async()=>{
  try{
    const days=collectRestingDays();
    const r=await api("/api/settings/resting",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({resting_days:days})});
    await loadRestingSettings();
    alert("养豆规则已保存，豆仓刷新后按新规则分类。");
  }catch(e){ alert("保存失败："+e.message); }
};
$("#resetRestingBtn").onclick=async()=>{
  if(!confirm("恢复为系统默认养豆天数（浅烘14 / 中浅烘12 / 中烘10 / 中深烘7 / 深烘5）？"))return;
  try{
    await api("/api/settings/resting",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({reset:true})});
    await loadRestingSettings();
    alert("已恢复默认养豆规则。");
  }catch(e){ alert("恢复默认失败："+e.message); }
};
