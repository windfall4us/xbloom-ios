$("#importBtn").onclick=()=>$("#importDialog").showModal();
$("#closeImportBtn").onclick=()=>$("#importDialog").close();

async function doImport(target){
 if(!selected)return;
 const yamlText=$("#importYaml").value.trim();
 if(!yamlText)return alert("请先粘贴 YAML。");
 try{
   const r=await api(`/api/beans/${encodeURIComponent(selected.bean_id)}/recipes/import`,{
     method:"POST",
     headers:{"Content-Type":"application/json"},
     body:JSON.stringify({yaml_text:yamlText,target})
   });
   alert(`导入成功：${r.kind} v${r.version}\n状态：${r.readiness.state}\n当前版本未改变。`);
   $("#importDialog").close();
   $("#importYaml").value="";
   await showHistory();
 }catch(e){
   alert("导入失败："+e.message);
 }
}
