   });
   $("#cfgCloudPassword").value="";
   renderCloudSettingsState(r.settings);
   await loadSystemStatus();
   alert("xBloom 云端账号已保存。");
 }catch(e){
   alert("保存 Cloud 账号失败："+e.message);
 }
};

$("#testCloudLoginBtn").onclick=async()=>{
 const btn=$("#testCloudLoginBtn");
 const old=btn.textContent;
 btn.disabled=true;
 btn.textContent="测试中…";
 try{
   const r=await api("/api/cloud/test",{
     method:"POST",
     headers:{"Content-Type":"application/json"},
     body:JSON.stringify({
       email:$("#cfgCloudEmail").value.trim(),
       password:$("#cfgCloudPassword").value
     })
   });
   alert(`云端登录成功。\n账号：${r.email||"—"}`);
   await loadCloudSettings();
   await loadSystemStatus();
 }catch(e){
   alert("云端登录测试失败："+e.message);
 }finally{
   btn.disabled=false;
   btn.textContent=old;
 }
};

$("#clearCloudSettingsBtn").onclick=async()=>{
 if(!confirm("清除网页中保存的 xBloom Cloud 邮箱和密码？\n\n如果服务器环境变量仍配置了账号，系统会自动回退使用环境变量。"))return;
 try{
   const r=await api("/api/cloud/settings/clear",{method:"POST"});
   $("#cfgCloudEmail").value="";
   $("#cfgCloudPassword").value="";
   renderCloudSettingsState(r.settings);
   await loadSystemStatus();
   alert("网页 云端配置已清除。");
 }catch(e){
   alert("清除 Cloud 配置失败："+e.message);
 }
};

